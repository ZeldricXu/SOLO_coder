<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress checks="MissingJavadocMethod" files=".*Test\.java$"/>
    <suppress checks="MissingJavadocMethod" files=".*Configuration\.java$"/>
    <suppress checks="MissingJavadocMethod" files=".*Controller\.java$"/>
    <suppress checks="MissingJavadocMethod" files=".*Application\.java$"/>
    <suppress checks="MissingJavadocMethod" files=".*Mapper\.java$"/>

    <suppress checks="MagicNumber" files=".*Controller\.java$"/>
    <suppress checks="MagicNumber" files=".*Test\.java$"/>
    <suppress checks="MagicNumber" files=".*Config.*\.java$"/>

    <suppress checks="ParameterNumber" files=".*DTO\.java$"/>
    <suppress checks="ParameterNumber" files=".*Entity\.java$"/>

    <suppress checks="VisibilityModifier" files=".*Entity\.java$"/>
    <suppress checks="VisibilityModifier" files=".*DTO\.java$"/>

    <suppress checks="MethodLength" files=".*Test\.java$"/>
    <suppress checks="MethodLength" files=".*Config.*\.java$"/>

    <suppress checks="FileLength" files=".*Application\.java$"/>

    <suppress checks="CyclomaticComplexity" files=".*ServiceImpl\.java$"/>
    <suppress checks="JavaNCSS" files=".*ServiceImpl\.java$"/>
</suppressions>
