# ============================================
# Stage 1: Builder
# ============================================
FROM rust:1.75-alpine3.19 AS builder

WORKDIR /app

RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    perl \
    make \
    gcc \
    g++ \
    pkgconfig \
    ca-certificates

RUN rustup target add x86_64-unknown-linux-musl

COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs
RUN cargo build --release --target x86_64-unknown-linux-musl
RUN rm -rf src

COPY . .
RUN cargo build --release --target x86_64-unknown-linux-musl

# ============================================
# Stage 2: Alpine Runtime
# ============================================
FROM alpine:3.19

LABEL org.opencontainers.image.title="Enterprise Platform (Alpine)"
LABEL org.opencontainers.image.description="Enterprise-grade platform - Alpine lightweight"
LABEL org.opencontainers.image.source="https://github.com/platform/enterprise_platform"
LABEL org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl

WORKDIR /app

COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/enterprise_platform /usr/local/bin/

RUN adduser -D appuser
USER appuser

ENV RUST_LOG=info
ENV APP_ENV=production

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["enterprise_platform"]
