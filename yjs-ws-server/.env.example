# WebSocket port for Yjs connections
WS_PORT=1234

# HTTP API port for room management
HTTP_PORT=1235

# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_hub?schema=public"

# Redis for multi-instance broadcasting (optional)
REDIS_URL="redis://localhost:6379"
REDIS_CHANNEL="yjs-collab"

# Document save debounce time (ms)
SAVE_DEBOUNCE_MS=2000

# Yjs garbage collection
GC_ENABLED=true

# JWT secret for authentication
JWT_SECRET="your-secret-key-here"
