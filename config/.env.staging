APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=infra-platform-staging
DEBUG=false
LOG_LEVEL=info

# 数据库配置
DATABASE_URL=postgresql+asyncpg://staging_user:${DB_PASSWORD}@postgres-staging:5432/infra_platform_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# 缓存配置
CACHE_TYPE=redis
CACHE_URL=redis://redis-staging:6379/0
CACHE_TTL=1800
CACHE_MAX_SIZE=50000

# Redis配置
REDIS_URL=redis://redis-staging:6379/1
REDIS_POOL_SIZE=100

# JWT配置
JWT_SECRET_KEY=${JWT_SECRET}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=3

# 速率限制
RATE_LIMIT_DEFAULT=500
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=1000

# 对象存储
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./storage/staging
STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_S3_BUCKET=infra-platform-staging
STORAGE_S3_ACCESS_KEY=${S3_ACCESS_KEY}
STORAGE_S3_SECRET_KEY=${S3_SECRET_KEY}

# 监控配置
MONITORING_ENABLED=true
METRICS_PORT=9090
ALERT_WEBHOOK_URL=https://staging.example.com/webhook
ALERT_SLACK_WEBHOOK=${SLACK_WEBHOOK}

# 文档索引
DOCUMENT_INDEX_PATH=./index/staging
DOCUMENT_SYNC_INTERVAL=600

# 配置管理
CONFIG_WATCH_ENABLED=true
CONFIG_REFRESH_INTERVAL=30

# CORS
CORS_ORIGINS=https://staging.example.com,https://admin-staging.example.com
CORS_ALLOW_CREDENTIALS=true

# 健康检查
HEALTH_CHECK_INTERVAL=30
READINESS_PROBE_DELAY=10
LIVENESS_PROBE_DELAY=30
