APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=infra-platform
DEBUG=false
LOG_LEVEL=warning

# 数据库配置
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@postgres-prod:5432/infra_platform
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=100
DATABASE_POOL_RECYCLE=3600
DATABASE_STATEMENT_TIMEOUT=30000

# 缓存配置
CACHE_TYPE=redis
CACHE_URL=redis://redis-prod:6379/0
CACHE_TTL=900
CACHE_MAX_SIZE=200000

# Redis配置
REDIS_URL=redis://redis-prod:6379/1
REDIS_POOL_SIZE=200
REDIS_SOCKET_TIMEOUT=5000
REDIS_SOCKET_CONNECT_TIMEOUT=5000

# JWT配置
JWT_SECRET_KEY=${JWT_SECRET}
JWT_ALGORITHM=ES256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# 速率限制
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=2000

# 对象存储
STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_S3_BUCKET=infra-platform-production
STORAGE_S3_ACCESS_KEY=${S3_ACCESS_KEY}
STORAGE_S3_SECRET_KEY=${S3_SECRET_KEY}
STORAGE_S3_SSE=AES256

# 监控配置
MONITORING_ENABLED=true
METRICS_PORT=9090
ALERT_WEBHOOK_URL=https://api.example.com/webhook
ALERT_SLACK_WEBHOOK=${SLACK_WEBHOOK}
ALERT_EMAIL_FROM=alerts@example.com

# 文档索引
DOCUMENT_INDEX_PATH=./index/prod
DOCUMENT_SYNC_INTERVAL=300

# 配置管理
CONFIG_WATCH_ENABLED=true
CONFIG_REFRESH_INTERVAL=15

# CORS
CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true

# 安全
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'

# 性能
WORKERS=4
UVICORN_LOOP=uvloop
UVICORN_HTTP=httptools
