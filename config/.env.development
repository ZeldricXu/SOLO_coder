APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=infra-platform-dev
DEBUG=true
LOG_LEVEL=debug

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# 缓存配置
CACHE_TYPE=memory
CACHE_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# Redis配置
REDIS_URL=redis://localhost:6379/1
REDIS_POOL_SIZE=50

# JWT配置
JWT_SECRET_KEY=dev-secret-key-change-in-production-please-001
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 速率限制
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=150

# 对象存储
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/dev
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=infra-platform-dev
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin

# 监控配置
MONITORING_ENABLED=true
METRICS_PORT=9090
ALERT_WEBHOOK_URL=http://localhost:8080/webhook
ALERT_SLACK_WEBHOOK=

# 文档索引
DOCUMENT_INDEX_PATH=./index/dev
DOCUMENT_SYNC_INTERVAL=300

# 配置管理
CONFIG_WATCH_ENABLED=true
CONFIG_REFRESH_INTERVAL=60

# CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
