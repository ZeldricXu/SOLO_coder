<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/etc/filter.xsd">

    <Match>
        <Package name="com.chainetl.*.dto"/>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Package name="com.chainetl.*.model"/>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Package name="com.chainetl.common.handler"/>
        <Bug pattern="SQL_INJECTION"/>
    </Match>

    <Match>
        <Class name="~.*Mapper$"/>
        <Bug pattern="SQL_INJECTION"/>
    </Match>

    <Match>
        <Package name="com.chainetl.modules.zkp"/>
        <Bug pattern="WEAK_MESSAGE_DIGEST"/>
    </Match>

    <Match>
        <Package name="com.chainetl.modules.tx"/>
        <Bug pattern="WEAK_MESSAGE_DIGEST"/>
    </Match>

    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Priority value="3"/>
    </Match>

    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH"/>
        <Priority value="3"/>
    </Match>

    <Match>
        <Class name="~.*Controller$"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <Match>
        <Class name="~.*Service$"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <Match>
        <Bug pattern="UUF_UNUSED_FIELD"/>
        <Priority value="3"/>
    </Match>

    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Priority value="3"/>
    </Match>
</FindBugsFilter>
