<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <module name="TreeWalker">
        <module name="ConstantName"/>
        <module name="EmptyBlock">
            <property name="option" value="STMT"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="FinalParameters"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Exception, java.lang.RuntimeException"/>
        </module>
        <module name="JavadocStyle"/>
        <module name="MagicNumber">
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="false"/>
            <property name="constantWaiverParentToken" value="COMPILATION_UNIT,METHOD_DEF,VARIABLE_DEF"/>
        </module>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="MethodParamPad"/>
        <module name="NoFinalizer"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="OneStatementPerLine"/>
        <module name="PackageName"/>
        <module name="ParameterName"/>
        <module name="RedundantImport"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StaticVariableName"/>
        <module name="UnusedImports"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
        </module>
        <module name="GenericWhitespace"/>
        <module name="AvoidNestedBlocks"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean,
                java.lang.Double, java.lang.Float, java.lang.Integer,
                java.lang.Long"/>
        </module>
        <module name="SynchronizedOnString"/>
        <module name="ArrayTypeStyle"/>
        <module name="LeftCurly">
            <property name="option" value="nl"/>
        </module>
        <module name="RightCurly"/>
    </module>

    <module name="NewlineAtEndOfFile"/>
    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="UniqueProperties"/>
    <module name="RegexpSingleline">
        <property name="format" value="System\.out\.println|System\.err\.println"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Use logger instead of System.out/err.println"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+(@SuppressWarnings|@Deprecated)"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Annotation has preceding whitespace"/>
    </module>
</module>
