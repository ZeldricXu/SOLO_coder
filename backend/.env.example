SMTP_USE_SSL=true

# 默认收件邮箱（汇总报告）
DEFAULT_REPORT_EMAILS=admin@example.com,manager@example.com

# Wiki配置
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

