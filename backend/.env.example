# 服务配置
SERVER_PORT=8080
SERVER_MODE=release

# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=featureflag
DATABASE_SSLMODE=disable
DATABASE_MAX_IDLE_CONNS=10
DATABASE_MAX_OPEN_CONNS=100

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# Kafka配置
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=featureflag-events
KAFKA_GROUP_ID=featureflag-server

# 缓存配置
CACHE_TYPE=memory
CACHE_TTL=300
CACHE_MAX_SIZE=10000

# SDK配置
SDK_POLL_INTERVAL=30
SDK_LONG_POLL_TIMEOUT=60
SDK_CIRCUIT_BREAKER_THRESHOLD=5
SDK_CIRCUIT_BREAKER_TIMEOUT=30

# 认证配置
JWT_SECRET=featureflag-secret-key
JWT_EXPIRE=86400

# 自动回滚配置
AUTO_ROLLBACK_ENABLED=true
AUTO_ROLLBACK_CHECK_INTERVAL=60
AUTO_ROLLBACK_WINDOW_MINUTES=15
