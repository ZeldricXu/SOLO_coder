REMINDER_MONDAY_MINUTE=0
REMINDER_WEDNESDAY_HOUR=10
REMINDER_WEDNESDAY_MINUTE=0
REMINDER_FRIDAY_HOUR=10
REMINDER_FRIDAY_MINUTE=0
SUMMARY_FRIDAY_HOUR=18
SUMMARY_FRIDAY_MINUTE=0
