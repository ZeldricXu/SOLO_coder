APP_NAME=DataFlow 实时数据流分析平台
APP_VERSION=1.1.0
DEBUG=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dataflow

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=dataflow-consumer
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MANUAL_COMMIT_INTERVAL=5000
KAFKA_ENABLE_OFFSET_PERSISTENCE=true

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=root
INFLUXDB_ORG=dataflow
INFLUXDB_BUCKET=metrics

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX
SLACK_CHANNEL=#alerts
SLACK_ENABLED=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=alerts@example.com
SMTP_TO=admin1@example.com,admin2@example.com
SMTP_USE_TLS=true
SMTP_ENABLED=false

PIPELINE_CONFIG_PATH=config/pipelines.yaml
PIPELINE_AUTO_RELOAD=false
PIPELINE_RELOAD_INTERVAL=60

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

BATCH_WRITE_INTERVAL=5
MAX_BATCH_SIZE=1000
