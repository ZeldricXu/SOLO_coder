APP_NAME=周报自动汇总系统
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=sqlite:///./weekly_report.db

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 企业微信配置
WECOM_BOT_WEBHOOK=
WECOM_CORP_ID=
