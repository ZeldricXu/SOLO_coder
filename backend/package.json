{
  "name": "wikihub-backend",
  "version": "1.0.0",
  "description": "WikiHub 知识库文档协作平台后端服务",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["wiki", "collaboration", "document", "editor"],
  "author": "WikiHub Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "mongoose": "^7.5.0",
    "elasticsearch": "^16.7.3",
    "@elastic/elasticsearch": "^8.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "puppeteer": "^21.3.6",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^8.15.1",
    "jest-mock": "^29.7.0",
    "@types/jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "coverageDirectory": "./coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/coverage/"
    ]
  }
}
