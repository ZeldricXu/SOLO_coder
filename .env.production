# ========================================
# 生产环境配置
# ========================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4
APP_NAME=ticket-routing-system

# ========================================
# 安全配置（必须通过环境变量注入，禁止硬编码）
# ========================================
SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# API 配置
# ========================================
API_PREFIX=/api/v1
CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]

# ========================================
# 数据库配置（生产环境使用 PostgreSQL）
# ========================================
DATABASE_URL=${DATABASE_URL}
SYNC_DATABASE_URL=${SYNC_DATABASE_URL}
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_RECYCLE=900
DB_ECHO=false

# ========================================
# Redis 配置
# ========================================
REDIS_URL=${REDIS_URL}
REDIS_POOL_SIZE=50
REDIS_MAX_CONNECTIONS=100

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=WARNING
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(trace_id)s - %(message)s

# ========================================
# 限流配置
# ========================================
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=500

# ========================================
# 监控配置
# ========================================
SENTRY_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_PORT=9090

# ========================================
# 功能开关
# ========================================
FEATURE_FLAG_SKILL_MATCHING=true
FEATURE_FLAG_LOAD_BALANCING=true
FEATURE_FLAG_AUTO_ASSIGNMENT=true
