APP_ENV=production

SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_JWT_SECRET=${SERVER_JWT_SECRET}

DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=inference_platform
DB_SSLMODE=require

REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

TRITON_GRPC_HOST=${TRITON_GRPC_HOST}
TRITON_GRPC_PORT=8001
TRITON_HTTP_PORT=8000
TRITON_MODEL_REPOSITORY_PATH=s3://inference-models-production

ORCHESTRATOR_RUNTIME_MODE=kubernetes
ORCHESTRATOR_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.01-py3
ORCHESTRATOR_HEALTH_CHECK_INTERVAL=3s
ORCHESTRATOR_HEALTH_CHECK_INFERENCE=true
ORCHESTRATOR_MIN_REPLICAS=2
ORCHESTRATOR_MAX_REPLICAS=50

MONITORING_PROMETHEUS_PORT=9090
MONITORING_LOG_LEVEL=warn

WEBHOOK_ENABLED=true
WEBHOOK_AUTH_TOKEN=${WEBHOOK_AUTH_TOKEN}

NOTIFICATION_DINGTALK_ENABLED=true
NOTIFICATION_DINGTALK_WEBHOOK_URL=${DINGTALK_WEBHOOK_URL}
NOTIFICATION_DINGTALK_SECRET=${DINGTALK_SECRET}

NOTIFICATION_WECHAT_WORK_ENABLED=true
NOTIFICATION_WECHAT_WORK_WEBHOOK_URL=${WECHAT_WORK_WEBHOOK_URL}
