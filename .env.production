# ============================================
# 生产环境配置
# ============================================

# 服务配置
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL="postgresql://chaoslab:${DB_PASSWORD}@postgres:5432/chaoslab_production?schema=public"
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_TIMEOUT=30000
DB_SSL=true

# Redis 配置
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
REDIS_POOL_MIN=10
REDIS_POOL_MAX=50
REDIS_SSL=true
REDIS_CLUSTER=false

# 安全配置
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRES_IN="15m"
BCRYPT_ROUNDS=14
SESSION_SECRET="${SESSION_SECRET}"

# 日志配置
LOG_LEVEL=warn
LOG_PRETTY=false
LOG_FILE_PATH="/var/log/chaoslab/app.log"
LOG_MAX_SIZE="100m"
LOG_MAX_FILES=10

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_STANDARD_HEADERS=true
RATE_LIMIT_LEGACY_HEADERS=false

# CORS 配置
CORS_ORIGIN="https://chaoslab.io,https://*.chaoslab.io"
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# 监控配置
METRICS_ENABLED=true
METRICS_PATH="/metrics"
HEALTH_CHECK_PATH="/health"
TRACING_ENABLED=true
PROFILING_ENABLED=false

# 功能开关
FEATURE_CHAOS_INJECTION=true
FEATURE_AUDIT_LOG=true
FEATURE_TRAFFIC_CONTROL=true
FEATURE_DNS_PROXY=true
FEATURE_MTLS_CERT=true
FEATURE_EVENT_STORE=true
FEATURE_IMAGE_DISTRIBUTION=true
FEATURE_SIDECAR=true

# 性能配置
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=1024
BODY_PARSER_LIMIT="10mb"
TRUST_PROXY=true
