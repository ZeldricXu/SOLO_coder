APP_NAME=enterprise_platform
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=info

RUST_LOG=enterprise_platform=info,tower_http=info,axum=warn

DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_CONNECT_TIMEOUT=5

REDIS_URL=
REDIS_POOL_SIZE=50

MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=

TEE_ENABLED=false
TEE_TYPE=sgx
TEE_SIMULATION=false

SHAMIR_THRESHOLD=5
SHAMIR_TOTAL_SHARES=7
SHAMIR_KEYSTORE_PATH=/var/lib/enterprise_platform/shares

AUDIT_LOG_PATH=/var/log/enterprise_platform/audit.log
AUDIT_LOG_MAX_SIZE=104857600
AUDIT_LOG_MAX_FILES=20

MASKING_ENABLED=true
MASKING_DEFAULT_PATTERN=****

RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=60

JWT_SECRET=
JWT_EXPIRE_HOURS=24

API_GATEWAY_TIMEOUT=10
API_GATEWAY_MAX_BODY_SIZE=10485760

TRACE_ID_HEADER=x-trace-id
SIGNATURE_HEADER=x-signature
TIMESTAMP_HEADER=x-timestamp
TIMESTAMP_MAX_AGE=300
