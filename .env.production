# 生产环境配置
# 注意：敏感配置应通过 Kubernetes Secrets、Vault 或其他安全方式注入

# 服务配置
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 日志配置
LOG_LEVEL=warn
LOG_JSON=true
LOG_DIR=/var/log/app

# JWT 配置
# 必须通过环境变量或密钥管理系统注入
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3d

# 速率限制（生产环境严格限制）
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
TENANT_RATE_LIMIT_MAX=1000
TENANT_RATE_LIMIT_WINDOW=60000
USER_RATE_LIMIT_MAX=200
USER_RATE_LIMIT_WINDOW=60000

# Redis 配置
REDIS_HOST=${REDIS_HOST:-redis}
REDIS_PORT=${REDIS_PORT:-6379}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false
REDIS_TLS_ENABLED=true

# 数据库配置
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50
DATABASE_TIMEOUT=5000
DATABASE_SSL_ENABLED=true

# 并发配置
MAX_CONCURRENT=100
SCHEDULER_MAX_CONCURRENT=10
SCHEDULER_RETRY=3

# 计费配置
PRICE_API_CALL=0.001
PRICE_STORAGE=0.05
PRICE_COMPUTE=0.01
PRICE_BANDWIDTH=0.02
BILLING_CURRENCY=CNY
BILLING_CYCLE_DAYS=30

# 存储配置
BACKUP_DIR=/data/backups
BACKUP_COMPRESSION=9
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY=${BACKUP_ENCRYPTION_KEY}
BACKUP_RETENTION_DAYS=90

# 监控配置
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=5000

# 跨域配置
CORS_ORIGIN=${CORS_ORIGIN:-https://yourdomain.com}
CORS_CREDENTIALS=true

# 调试配置（生产环境禁用）
DEBUG=false
TRACE_ENABLED=false
SLOW_REQUEST_THRESHOLD=500

# 安全配置
SESSION_SECRET=${SESSION_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
API_KEY_HEADER=x-api-key
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# 限流配置
BURST_LIMIT=200
QUEUE_LIMIT=500

# 数据保留
LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
