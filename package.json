{
  "name": "auth-gateway-platform",
  "version": "1.0.0",
  "description": "认证鉴权与速率限制平台",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:debug": "ts-node-dev --respawn --transpile-only --inspect src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "prepare": "husky install",
    "clean": "rm -rf dist coverage",
    "clean:all": "rm -rf dist coverage node_modules",
    "docker:build": "docker build -t auth-platform .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production auth-platform",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:dev": "docker compose -f docker-compose.dev.yml up -d",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.3.2",
    "node-cache": "^5.1.2",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "cron": "^3.1.6",
    "dayjs": "^1.11.10",
    "nanoid": "^3.3.7",
    "axios": "^1.6.2",
    "lodash": "^4.17.21",
    "dotenv": "^16.3.1",
    "dotenv-expand": "^10.0.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@types/pg": "^8.10.9",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "jest-junit": "^16.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-unicorn": "^50.0.1",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "eslint-import-resolver-typescript": "^3.6.1",
    "standard-version": "^9.5.0"
  }
}
