{
  "name": "create-solo-project",
  "version": "1.0.0",
  "description": "A CLI tool for scaffolding standardized TypeScript projects",
  "bin": {
    "create-solo-project": "./dist/index.js",
    "csp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "cp -r src/templates/content dist/templates/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "project-generator",
    "boilerplate"
  ],
  "author": "SoloCoder Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.2.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.1",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.23",
    "ora": "^8.0.1",
    "semver": "^7.6.2",
    "simple-git": "^3.25.0",
    "which": "^4.0.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/semver": "^7.5.8",
    "@types/which": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.5.0",
    "globals": "^15.4.0",
    "jest": "^29.7.0",
    "memfs": "^4.57.8",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
