    "express": "^4.19.2",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "node-cache": "^5.1.2",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "axios": "^1.7.2",
    "moment": "^2.30.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/lodash": "^4.17.4",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "prettier": "^3.2.5"
