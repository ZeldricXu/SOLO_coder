{
  "name": "blockchain-gas-orchestration",
  "version": "1.0.0",
  "description": "Enterprise-grade blockchain transaction orchestration platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/interfaces/http/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/interfaces/http/server.ts",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testPathPattern=unit",
    "lint": "eslint 'src/**/*.ts' --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "fastify": "^4.26.0",
    "zod": "^3.22.4",
    "viem": "^2.7.0",
    "ethers": "^6.10.0",
    "ioredis": "^5.3.2",
    "node-cache": "^5.1.2",
    "@prisma/client": "^5.9.0",
    "helia": "^4.0.0",
    "axios": "^1.6.5",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "prisma": "^5.9.0"
  }
}
