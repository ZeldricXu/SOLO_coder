{
  "name": "@df1-57/design-system",
  "version": "1.0.0",
  "description": "A comprehensive TypeScript React component library with design system",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.js"
    },
    "./Button": {
      "types": "./dist/types/components/Button/index.d.ts",
      "import": "./dist/esm/components/Button/index.js",
      "require": "./dist/cjs/components/Button/index.js"
    },
    "./Input": {
      "types": "./dist/types/components/Input/index.d.ts",
      "import": "./dist/esm/components/Input/index.js",
      "require": "./dist/cjs/components/Input/index.js"
    },
    "./Select": {
      "types": "./dist/types/components/Select/index.d.ts",
      "import": "./dist/esm/components/Select/index.js",
      "require": "./dist/cjs/components/Select/index.js"
    },
    "./Checkbox": {
      "types": "./dist/types/components/Checkbox/index.d.ts",
      "import": "./dist/esm/components/Checkbox/index.js",
      "require": "./dist/cjs/components/Checkbox/index.js"
    },
    "./Radio": {
      "types": "./dist/types/components/Radio/index.d.ts",
      "import": "./dist/esm/components/Radio/index.js",
      "require": "./dist/cjs/components/Radio/index.js"
    },
    "./Switch": {
      "types": "./dist/types/components/Switch/index.d.ts",
      "import": "./dist/esm/components/Switch/index.js",
      "require": "./dist/cjs/components/Switch/index.js"
    },
    "./Toast": {
      "types": "./dist/types/components/Toast/index.d.ts",
      "import": "./dist/esm/components/Toast/index.js",
      "require": "./dist/cjs/components/Toast/index.js"
    },
    "./Tooltip": {
      "types": "./dist/types/components/Tooltip/index.d.ts",
      "import": "./dist/esm/components/Tooltip/index.js",
      "require": "./dist/cjs/components/Tooltip/index.js"
    },
    "./Form": {
      "types": "./dist/types/components/Form/index.d.ts",
      "import": "./dist/esm/components/Form/index.js",
      "require": "./dist/cjs/components/Form/index.js"
    },
    "./Table": {
      "types": "./dist/types/components/Table/index.d.ts",
      "import": "./dist/esm/components/Table/index.js",
      "require": "./dist/cjs/components/Table/index.js"
    },
    "./Modal": {
      "types": "./dist/types/components/Modal/index.d.ts",
      "import": "./dist/esm/components/Modal/index.js",
      "require": "./dist/cjs/components/Modal/index.js"
    },
    "./Drawer": {
      "types": "./dist/types/components/Drawer/index.d.ts",
      "import": "./dist/esm/components/Drawer/index.js",
      "require": "./dist/cjs/components/Drawer/index.js"
    },
    "./Dropdown": {
      "types": "./dist/types/components/Dropdown/index.d.ts",
      "import": "./dist/esm/components/Dropdown/index.js",
      "require": "./dist/cjs/components/Dropdown/index.js"
    },
    "./Tabs": {
      "types": "./dist/types/components/Tabs/index.d.ts",
      "import": "./dist/esm/components/Tabs/index.js",
      "require": "./dist/cjs/components/Tabs/index.js"
    }
  },
  "bin": {
    "df1-57-tokens": "./dist/cjs/cli/index.js"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "tokens:sync": "ts-node src/cli/index.ts sync",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.9",
    "clsx": "^2.1.0",
    "react-hook-form": "^7.51.0",
    "@hookform/resolvers": "^3.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitest/coverage-v8": "^1.3.1",
    "chromatic": "^11.0.0",
    "commander": "^12.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.8.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.12.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^8.0.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
