{
  "name": "metricplatform",
  "version": "1.0.0",
  "description": "Enterprise-grade observability and automation platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc",
    "build:dev": "cross-env NODE_ENV=development npm run build",
    "build:staging": "cross-env NODE_ENV=staging npm run build",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "start:staging": "cross-env NODE_ENV=staging node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node src/index.ts",
    "dev:watch": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.js --watch --passWithNoTests",
    "test:coverage": "cross-env NODE_ENV=test jest --config jest.config.js --coverage --passWithNoTests",
    "test:ci": "cross-env NODE_ENV=test jest --config jest.config.js --ci --coverage --passWithNoTests",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "prettier": "prettier --check \"{src,test}/**/*.{ts,json,md}\"",
    "prettier:fix": "prettier --write \"{src,test}/**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint:staged": "lint-staged",
    "prepare": "husky install",
    "quality": "npm run lint && npm run typecheck && npm run test:ci",
    "prebuild": "npm run quality"
  },
  "dependencies": {
    "express": "^4.18.2",
    "fastify": "^4.25.0",
    "@fastify/rate-limit": "^9.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "ioredis": "^5.3.2",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.0",
    "ws": "^8.15.1",
    "pino": "^8.17.1",
    "pino-pretty": "^10.3.0",
    "dotenv": "^16.3.1",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-sonarjs": "^0.24.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src,test}/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
