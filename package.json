{
  "name": "multi-tenant-cms-api",
  "version": "1.0.0",
  "description": "Multi-tenant Content Management Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "drizzle:generate": "drizzle-kit generate:pg",
    "drizzle:migrate": "drizzle-kit migrate",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "@prisma/client": "^5.10.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "bullmq": "^5.1.0",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.10",
    "diff": "^5.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.29.3",
    "drizzle-zod": "^0.5.1",
    "fastify": "^4.26.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "pino-pretty": "^10.3.1",
    "ulid": "^2.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8.56.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
