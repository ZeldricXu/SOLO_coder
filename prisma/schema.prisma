generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String           @id @default(uuid())
  name           String
  email          String
  status         String           @default("active")
  attributes     Json             @default("{}")
  configs        TenantConfig[]
  resourceQuotas ResourceQuota[]
  usageRecords   UsageRecord[]
  invoices       Invoice[]
  tickets        Ticket[]
  processes      WorkflowProcess[]
  approvals      ApprovalInstance[]
  documents      Document[]
  slaPolicies    SLAPolicy[]
  skills         Skill[]
  agents         Agent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model TenantConfig {
  id         String   @id @default(uuid())
  tenantId   String
  namespace  String
  version    Int
  parameters Json
  enabled    Boolean  @default(true)
  appliedAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, namespace, version])
}

model ResourceQuota {
  id            String   @id @default(uuid())
  tenantId      String
  resourceType  String
  limit         Float
  used          Float    @default(0)
  unit          String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([tenantId, resourceType])
}

model BillingPlan {
  id         String   @id @default(uuid())
  name       String
  type       String
  price      Float
  currency   String
  features   Json
  active     Boolean  @default(true)
  tenants    Tenant[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UsageRecord {
  id              String   @id @default(uuid())
  tenantId        String
  resourceType    String
  quantity        Float
  unit            String
  eventSource     String
  eventId         String
  attributes      Json
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  billingPeriod   String
  createdAt       DateTime @default(now())
  @@index([tenantId, billingPeriod])
  @@index([eventId])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  billingPeriod  String
  amount         Float
  currency       String
  status         String        @default("pending")
  items          InvoiceItem[]
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  issuedAt       DateTime      @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([tenantId, billingPeriod])
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  resourceType String
  quantity   Float
  unitPrice  Float
  amount     Float
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  createdAt  DateTime @default(now())
}

model Skill {
  id              String               @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  category        String
  level           Int                  @default(1)
  parentId        String?
  parent          Skill?               @relation("SkillHierarchy", fields: [parentId], references: [id])
  children        Skill[]              @relation("SkillHierarchy")
  assessments     SkillAssessment[]
  agents          Agent[]              @relation("AgentSkills")
  learningPaths   LearningPathSkill[]
  ticketTypes     TicketSkillRequirement[]
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Agent {
  id              String               @id @default(uuid())
  tenantId        String
  name            String
  email           String
  status          String               @default("available")
  currentLoad     Float                @default(0)
  maxLoad         Float                @default(100)
  skills          Skill[]              @relation("AgentSkills")
  assessments     SkillAssessment[]
  tickets         Ticket[]
  assignments     TicketAssignment[]
  learningPaths   LearningPath[]
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model SkillAssessment {
  id         String   @id @default(uuid())
  agentId    String
  skillId    String
  level      Float
  certification String?
  verified   Boolean  @default(false)
  agent      Agent    @relation(fields: [agentId], references: [id])
  skill      Skill    @relation(fields: [skillId], references: [id])
  assessedAt DateTime @default(now())
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  @@unique([agentId, skillId])
}

model LearningPath {
  id           String               @id @default(uuid())
  agentId      String
  name         String
  description  String?
  status       String               @default("in_progress")
  skills       LearningPathSkill[]
  agent        Agent                @relation(fields: [agentId], references: [id])
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model LearningPathSkill {
  id             String       @id @default(uuid())
  learningPathId String
  skillId        String
  order          Int
  status         String       @default("pending")
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id])
  skill          Skill        @relation(fields: [skillId], references: [id])
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  @@unique([learningPathId, skillId])
}

model Ticket {
  id                String                 @id @default(uuid())
  tenantId          String
  title             String
  description       String?
  type              String
  priority          String                 @default("medium")
  status            String                 @default("open")
  requiredSkills    TicketSkillRequirement[]
  assignments       TicketAssignment[]
  slaInstance       SLAInstance?
  approvals         ApprovalInstance[]
  agentId           String?
  agent             Agent?                 @relation(fields: [agentId], references: [id])
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model TicketSkillRequirement {
  id        String @id @default(uuid())
  ticketId  String
  skillId   String
  minLevel  Float
  ticket    Ticket @relation(fields: [ticketId], references: [id])
  skill     Skill  @relation(fields: [skillId], references: [id])
  createdAt DateTime @default(now())
  @@unique([ticketId, skillId])
}

model TicketAssignment {
  id        String   @id @default(uuid())
  ticketId  String
  agentId   String
  reason    String
  score     Float
  status    String   @default("active")
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])
  createdAt DateTime @default(now())
}

model WorkflowProcess {
  id         String            @id @default(uuid())
  tenantId   String
  name       String
  version    Int               @default(1)
  status     String            @default("draft")
  nodes      ProcessNode[]
  edges      ProcessEdge[]
  instances  ProcessInstance[]
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  @@unique([tenantId, name, version])
}

model ProcessNode {
  id              String              @id @default(uuid())
  processId       String
  type            String
  name            String
  positionX       Float
  positionY       Float
  config          Json
  incomingEdges   ProcessEdge[]       @relation("IncomingEdges")
  outgoingEdges   ProcessEdge[]       @relation("OutgoingEdges")
  process         WorkflowProcess     @relation(fields: [processId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ProcessEdge {
  id            String        @id @default(uuid())
  processId     String
  sourceNodeId  String
  targetNodeId  String
  condition     Json?
  source        ProcessNode   @relation("OutgoingEdges", fields: [sourceNodeId], references: [id])
  target        ProcessNode   @relation("IncomingEdges", fields: [targetNodeId], references: [id])
  process       WorkflowProcess @relation(fields: [processId], references: [id])
  createdAt     DateTime      @default(now())
  @@unique([processId, sourceNodeId, targetNodeId])
}

model ProcessInstance {
  id              String            @id @default(uuid())
  processId       String
  entityId        String
  status          String            @default("running")
  currentNodeId   String?
  phase           String
  progress        Float             @default(0)
  variables       Json
  errorDetail     String?
  process         WorkflowProcess   @relation(fields: [processId], references: [id])
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ApprovalRule {
  id             String              @id @default(uuid())
  tenantId       String
  name           String
  type           String
  config         Json
  instances      ApprovalInstance[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ApprovalInstance {
  id              String              @id @default(uuid())
  ticketId        String
  ruleId          String
  status          String              @default("pending")
  strategy        String
  approvers       ApprovalParticipant[]
  variables       Json
  ticket          Ticket              @relation(fields: [ticketId], references: [id])
  rule            ApprovalRule        @relation(fields: [ruleId], references: [id])
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ApprovalParticipant {
  id                String              @id @default(uuid())
  approvalId        String
  approverId        String
  approverType      String
  status            String              @default("pending")
  comment           String?
  resolvedAt        DateTime?
  dynamicResolver   String?
  approval          ApprovalInstance    @relation(fields: [approvalId], references: [id])
  createdAt         DateTime            @default(now())
  @@unique([approvalId, approverId, approverType])
}

model Document {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  contentType   String
  contentHash   String
  versions      DocumentVersion[]
  comparisons   DocumentComparison[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model DocumentVersion {
  id          String      @id @default(uuid())
  documentId  String
  version     Int
  content     String
  createdBy   String?
  document    Document    @relation(fields: [documentId], references: [id])
  createdAt   DateTime    @default(now())
  @@unique([documentId, version])
}

model DocumentComparison {
  id           String             @id @default(uuid())
  documentId   String
  fromVersion  Int
  toVersion    Int
  diffResult   Json
  summary      String?
  highlights   Json
  document     Document           @relation(fields: [documentId], references: [id])
  createdAt    DateTime           @default(now())
}

model SLAPolicy {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  ticketType       String
  priority         String
  responseTime     Int
  resolutionTime   Int
  escalationLevels EscalationLevel[]
  instances        SLAInstance[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  @@unique([tenantId, ticketType, priority])
}

model EscalationLevel {
  id          String      @id @default(uuid())
  policyId    String
  level       Int
  threshold   Float
  action      String
  targetRole  String?
  policy      SLAPolicy   @relation(fields: [policyId], references: [id])
  createdAt   DateTime    @default(now())
  @@unique([policyId, level])
}

model SLAInstance {
  id             String           @id @default(uuid())
  ticketId       String
  policyId       String
  status         String           @default("active")
  responseDeadline DateTime
  resolutionDeadline DateTime
  currentLevel   Int              @default(0)
  breachedAt     DateTime?
  ticket         Ticket           @relation(fields: [ticketId], references: [id])
  policy         SLAPolicy        @relation(fields: [policyId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([ticketId])
}

model MetricsSnapshot {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  metrics    Json
  dimensions Json
  createdAt  DateTime @default(now())
  @@index([timestamp])
}

model Entity {
  id         String   @id @default(uuid())
  type       String
  status     String
  attributes Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ConfigDefinition {
  configId   String   @id @default(uuid())
  namespace  String
  version    Int
  parameters Json
  enabled    Boolean  @default(true)
  appliedAt  DateTime @default(now())
  @@unique([namespace, version])
}

model RunInstance {
  runId       String   @id @default(uuid())
  entityId    String
  phase       String
  progress    Float    @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  errorDetail String?
}
