<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter">

    <Match>
        <Class name="~.*\.(entity|model|dto)\..*"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <Match>
        <Class name="~.*\.(entity|model|dto)\..*"/>
        <Bug pattern="NP_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <Match>
        <Class name="~.*\.entity\..*DO$"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <Match>
        <Class name="~.*\.dto\..*(Request|Response)$"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <Match>
        <Class name="~.*\.config\..*(Configuration|Config)$"/>
        <Bug pattern="NM_METHOD_NAMING_CONVENTION"/>
    </Match>

    <Match>
        <Method name="~.*(Bean|Mapper)$"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Package name="~com\.monitoring\..*\.config\..*"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
        <Class name="~.*\.service\..*"/>
    </Match>

    <Match>
        <Bug pattern="STCAL_INVOKE_ON_STATIC_DATE_FORMAT_INSTANCE"/>
    </Match>

    <Match>
        <Bug pattern="BC_UNCONFIRMED_CAST"/>
    </Match>

    <Match>
        <Bug pattern="DP_DO_INSIDE_DO_PRIVILEGED"/>
    </Match>

    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION"/>
        <Class name="~com\.monitoring\..*\..*Repository"/>
    </Match>

    <Match>
        <Bug pattern="SA_LOCAL_SELF_ASSIGNMENT"/>
    </Match>

    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
        <Class name="~com\.monitoring\..*\.config\..*"/>
    </Match>

</FindBugsFilter>
