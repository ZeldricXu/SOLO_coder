NODE_ENV=production

SERVER_PORT=3000
SERVER_HOST=0.0.0.0

JWT_SECRET=production-jwt-secret-use-secret-manager
JWT_EXPIRES_IN=1h
JWT_ISSUER=metricplatform-production

RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=60000

REDIS_HOST=redis-production
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

LOG_LEVEL=warn
LOG_PRETTY=false

STORAGE_TYPE=s3

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=metricplatform-production

CPU_SAMPLING_INTERVAL=100
MEMORY_SAMPLING_INTERVAL=10000
MAX_PROFILE_DURATION=60000

NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY=30000

EMAIL_ENABLED=true
WEBHOOK_ENABLED=true
SLACK_ENABLED=true

METRICS_WINDOW=60000
METRICS_MAX_POINTS=100000
METRICS_STORAGE=memory
