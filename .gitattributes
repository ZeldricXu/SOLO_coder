# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Go source files
*.go text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Makefiles
Makefile text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.cfg text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.bin binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.jpg binary
*.png binary
*.gif binary
*.ico binary

# Generated files
go.sum linguist-generated=true
go.mod linguist-generated=false
