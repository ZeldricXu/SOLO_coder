# 测试环境配置

# 服务配置
NODE_ENV=testing
PORT=3001
HOST=0.0.0.0

# 日志配置
LOG_LEVEL=info
LOG_JSON=true
LOG_DIR=./logs

# JWT 配置
JWT_SECRET=test-jwt-secret-key-2024-testing-environment
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=1d

# 速率限制（测试环境放宽限制）
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=60000
TENANT_RATE_LIMIT_MAX=100000
TENANT_RATE_LIMIT_WINDOW=60000
USER_RATE_LIMIT_MAX=10000
USER_RATE_LIMIT_WINDOW=60000

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_CLUSTER_ENABLED=false

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_platform_test
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=10000

# 并发配置
MAX_CONCURRENT=100
SCHEDULER_MAX_CONCURRENT=5
SCHEDULER_RETRY=1

# 计费配置
PRICE_API_CALL=0.001
PRICE_STORAGE=0.05
PRICE_COMPUTE=0.01
PRICE_BANDWIDTH=0.02
BILLING_CURRENCY=CNY
BILLING_CYCLE_DAYS=30

# 存储配置
BACKUP_DIR=./test-backups
BACKUP_COMPRESSION=3
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=7

# 监控配置
METRICS_ENABLED=false
METRICS_PORT=9091
HEALTH_CHECK_INTERVAL=5000

# 跨域配置
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# 调试配置
DEBUG=false
TRACE_ENABLED=false
SLOW_REQUEST_THRESHOLD=2000

# 测试配置
TEST_TIMEOUT=10000
TEST_RETRIES=0
