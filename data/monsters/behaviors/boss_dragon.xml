<?xml version="1.0" encoding="UTF-8"?>
<BehaviorTree id="boss_dragon" name="巨龙BossAI">
  <Selector>
    <Sequence>
      <Condition type="hp_below" threshold="0.5"/>
      <Condition type="cooldown_ready" spell="breath_fire"/>
      <Action type="cast_spell" spell="breath_fire"/>
      <Action type="call_for_help"/>
    </Sequence>
    <Sequence>
      <Condition type="can_see_player"/>
      <Condition type="in_range" range="3"/>
      <Condition type="cooldown_ready" spell="tail_swing"/>
      <Action type="cast_spell" spell="tail_swing"/>
    </Sequence>
    <Sequence>
      <Condition type="can_see_player"/>
      <Condition type="in_range" range="6"/>
      <Condition type="cooldown_ready" spell="breath_fire"/>
      <Action type="cast_spell" spell="breath_fire"/>
    </Sequence>
    <Sequence>
      <Condition type="can_see_player"/>
      <Action type="chase"/>
      <Condition type="in_attack_range"/>
      <Action type="attack"/>
    </Sequence>
    <Action type="patrol"/>
  </Selector>
</BehaviorTree>
