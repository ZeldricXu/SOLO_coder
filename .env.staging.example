NODE_ENV=staging

SERVER_PORT=3000
SERVER_HOST=0.0.0.0

JWT_SECRET=staging-jwt-secret-change-this
JWT_EXPIRES_IN=12h
JWT_ISSUER=metricplatform-staging

RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=60000

REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

LOG_LEVEL=info
LOG_PRETTY=false

STORAGE_TYPE=s3

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=metricplatform-staging

CPU_SAMPLING_INTERVAL=50
MEMORY_SAMPLING_INTERVAL=5000
MAX_PROFILE_DURATION=300000

NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=10000

EMAIL_ENABLED=true
WEBHOOK_ENABLED=true
SLACK_ENABLED=true

METRICS_WINDOW=60000
METRICS_MAX_POINTS=50000
METRICS_STORAGE=memory
