FROM rust:1.78 AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    openssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown
RUN cargo install trunk wasm-bindgen-cli --version 0.2.92

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY shared/Cargo.toml shared/Cargo.toml
COPY frontend/Cargo.toml frontend/Cargo.toml

RUN mkdir -p shared/src && echo "" > shared/src/lib.rs && \
    mkdir -p frontend/src && echo "" > frontend/src/lib.rs && \
    mkdir -p frontend/src/components && \
    mkdir -p frontend/src/pages && \
    mkdir -p frontend/src/services && \
    echo '<!DOCTYPE html><html><body><div id="app"></div></body></html>' > frontend/index.html

RUN cargo build --release --target wasm32-unknown-unknown --package frontend 2>/dev/null || true

COPY . .

RUN touch shared/src/lib.rs frontend/src/lib.rs

WORKDIR /app/frontend

RUN trunk build --release

FROM nginx:1.25-alpine

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
