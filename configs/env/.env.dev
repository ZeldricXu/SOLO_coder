APP_ENV=dev
APP_NAME=config-platform
PORT=8080

LOG_LEVEL=debug
LOG_FILE=logs/app.log

DATABASE_URL=postgres://postgres:postgres@localhost:5432/config_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0

CERT_ROTATION_DAYS=30
CERT_AUTO_ROTATE=true

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_BURST=200

POOL_SIZE=100
REQUEST_TIMEOUT=30s

ENABLE_PPROF=true
ENABLE_METRICS=true
