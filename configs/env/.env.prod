APP_ENV=prod
APP_NAME=config-platform
PORT=8080

LOG_LEVEL=warn
LOG_FILE=/var/log/config-platform/app.log

DATABASE_URL=postgres://postgres:${DB_PASSWORD}@prod-db:5432/config_platform?sslmode=require
REDIS_URL=redis://prod-redis:6379/0

CERT_ROTATION_DAYS=30
CERT_AUTO_ROTATE=true

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_BURST=2000

POOL_SIZE=500
REQUEST_TIMEOUT=30s

ENABLE_PPROF=false
ENABLE_METRICS=true
