APP_ENV=staging
APP_NAME=config-platform
PORT=8080

LOG_LEVEL=info
LOG_FILE=/var/log/config-platform/app.log

DATABASE_URL=postgres://postgres:${DB_PASSWORD}@staging-db:5432/config_platform?sslmode=require
REDIS_URL=redis://staging-redis:6379/0

CERT_ROTATION_DAYS=30
CERT_AUTO_ROTATE=true

RATE_LIMIT_REQUESTS=500
RATE_LIMIT_BURST=1000

POOL_SIZE=200
REQUEST_TIMEOUT=30s

ENABLE_PPROF=false
ENABLE_METRICS=true
