{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "database": {
    "dsn": "postgres://user:pass@localhost:5432/session316?sslmode=disable"
  },
  "redis": {
    "addr": "localhost:6379",
    "password": "",
    "db": 0
  },
  "logger": {
    "level": "info",
    "encoding": "json",
    "output_paths": ["stdout", "logs/app.log"]
  },
  "api": {
    "timeout": 30,
    "retries": 3,
    "rate_limit": {
      "max_concurrent": 1000,
      "queue_size": 5000
    },
    "routes": [
      {
        "path": "/api/v1/execute",
        "method": "POST",
        "protocol": "rest",
        "target": "internal",
        "transform": "none",
        "auth_required": false
      }
    ]
  },
  "tee": {
    "enclave_type": "sgx",
    "attestation_url": "https://attestation.example.com"
  },
  "mpc": {
    "protocol": "spdz",
    "participant_count": 3,
    "timeout": 300
  },
  "federated": {
    "max_epochs": 100,
    "learning_rate": 0.01,
    "aggregation": "fedavg"
  },
  "privacy": {
    "epsilon": 1.0,
    "delta": 1e-5,
    "sensitivity": 1.0,
    "mechanism": "laplace"
  }
}
