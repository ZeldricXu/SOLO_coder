<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.flightmgmt</groupId>
    <artifactId>FlightMgmt</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>FlightMgmt</name>
    <description>航班信息管理服务</description>

    <modules>
        <module>common</module>
        <module>flight</module>
        <module>search</module>
        <module>passenger</module>
        <module>booking</module>
        <module>status</module>
        <module>analysis</module>
        <module>change</module>
        <module>history</module>
        <module>api</module>
    </modules>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>2.7.18</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>common</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>flight</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>search</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>booking</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>status</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>analysis</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>change</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>passenger</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.flightmgmt</groupId>
                <artifactId>history</artifactId>
                <version>1.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>
