{
  "name": "dataexplorer",
  "version": "0.1.0",
  "description": "DataExplorer - Interactive Data Analysis Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.dataexplorer.app",
    "productName": "DataExplorer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app/dist"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "artifactName": "DataExplorer-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "DataExplorer-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "artifactName": "DataExplorer-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
