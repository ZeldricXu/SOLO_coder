APP_NAME=DocIntel-Staging
APP_ENV=staging
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=${SECRET_KEY}
WORKERS=4
CORS_ORIGINS=https://staging.docintel.example.com

DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_SYNC_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/2
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/3
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_MAX_RETRIES=3
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

MINIO_ENDPOINT=${MINIO_HOST}:${MINIO_PORT}
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_SECURE=true
MINIO_RAW_BUCKET=raw-documents-staging
MINIO_PROCESSED_BUCKET=processed-documents-staging
MINIO_MODEL_BUCKET=model-artifacts-staging
MINIO_BUCKET_BATCHES=batches-staging

OCR_LANGS=ch,en
OCR_USE_GPU=true
OCR_DET_MODEL_DIR=/models/ocr/det
OCR_REC_MODEL_DIR=/models/ocr/rec
OCR_CLS_MODEL_DIR=/models/ocr/cls

ML_MODEL_CACHE_DIR=/models/.cache
ML_DEVICE=cuda
ML_BATCH_SIZE=8
ML_MAX_SEQ_LENGTH=512
GPU_MEMORY_FRACTION=0.8
GPU_MEMORY_LIMIT_MB=8192

EXTRACTION_MODEL_NAME=qwen-vl-chat
EXTRACTION_MODEL_VERSION=1.0.0
EXTRACTION_MODEL_PATH=/models/extraction/qwen-vl-chat
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

LAYOUT_MODEL_NAME=layoutlmv3-base
LAYOUT_MODEL_VERSION=1.0.0
LAYOUT_MODEL_PATH=/models/layout/layoutlmv3-base

TABLE_MODEL_NAME=table-transformer-detection
TABLE_MODEL_VERSION=1.0.0
TABLE_MODEL_PATH=/models/table/table-transformer-detection

API_KEYS=${API_KEYS}
REQUIRE_API_KEY=true

RATE_LIMIT_PER_MINUTE=500
MAX_CONCURRENT_TASKS=16
TASK_TIMEOUT=3600
TASK_PRIORITY_HIGH=0
TASK_PRIORITY_MEDIUM=5
TASK_PRIORITY_LOW=10

LOG_LEVEL=INFO
LOG_DIR=/app/logs

AB_TEST_ENABLED=true
AB_TEST_TRAFFIC_SPLIT='{"model_v1": 0.7, "model_v2": 0.3}'
AB_TEST_METRICS=extraction_accuracy,review_rate,processing_time

ICD10_CODES_FILE=/app/data/icd10_codes.json
