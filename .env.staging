# ========================================
# 预发环境配置
# ========================================
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=2
APP_NAME=ticket-routing-system-staging

# ========================================
# 安全配置（请使用真实的密钥）
# ========================================
SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# API 配置
# ========================================
API_PREFIX=/api/v1
CORS_ORIGINS=["https://*.example.com","http://localhost:3000"]

# ========================================
# 数据库配置（预发环境使用 PostgreSQL）
# ========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ticket_routing_staging
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/ticket_routing_staging
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ========================================
# Redis 配置
# ========================================
REDIS_URL=redis://localhost:6379/1
REDIS_POOL_SIZE=20
REDIS_MAX_CONNECTIONS=50

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========================================
# 限流配置
# ========================================
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=200

# ========================================
# 监控配置
# ========================================
SENTRY_DSN=${SENTRY_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.5
METRICS_ENABLED=true
METRICS_PORT=9090

# ========================================
# 功能开关
# ========================================
FEATURE_FLAG_SKILL_MATCHING=true
FEATURE_FLAG_LOAD_BALANCING=true
FEATURE_FLAG_AUTO_ASSIGNMENT=true
