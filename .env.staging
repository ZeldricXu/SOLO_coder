# ============================================
# 预发布环境配置
# ============================================

# 服务配置
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL="postgresql://chaoslab:${DB_PASSWORD}@postgres:5432/chaoslab_staging?schema=public"
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_TIMEOUT=30000

# Redis 配置
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# 安全配置
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=12

# 日志配置
LOG_LEVEL=info
LOG_PRETTY=false
LOG_FILE_PATH="/var/log/chaoslab/app.log"

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# CORS 配置
CORS_ORIGIN="https://staging.chaoslab.io,https://*.staging.chaoslab.io"
CORS_CREDENTIALS=true

# 监控配置
METRICS_ENABLED=true
METRICS_PATH="/metrics"
HEALTH_CHECK_PATH="/health"

# 功能开关
FEATURE_CHAOS_INJECTION=true
FEATURE_AUDIT_LOG=true
FEATURE_TRAFFIC_CONTROL=true
FEATURE_DNS_PROXY=true
FEATURE_MTLS_CERT=true
FEATURE_EVENT_STORE=true
FEATURE_IMAGE_DISTRIBUTION=true
FEATURE_SIDECAR=true
