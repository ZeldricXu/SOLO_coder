{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@config/*": ["./config/*"],
      "@data-access/*": ["./data-access/*"],
      "@metrics/*": ["./metrics/*"],
      "@monitoring/*": ["./monitoring/*"],
      "@anomaly-detection/*": ["./anomaly-detection/*"],
      "@alerting/*": ["./alerting/*"],
      "@slo/*": ["./slo/*"],
      "@tracing/*": ["./tracing/*"],
      "@core/*": ["./core/*"],
      "@types/*": ["./types/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
