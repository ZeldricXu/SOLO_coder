<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cardgame</groupId>
        <artifactId>card-game-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>card-game-server</artifactId>
    <name>Card Game Server</name>
    <description>游戏主服务：整合所有模块、Spring配置、启动类</description>

    <dependencies>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-room</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-deck</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-battle</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-map</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-save</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-replay</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cardgame</groupId>
            <artifactId>card-game-rank</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.cardgame.server.CardGameServer</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
