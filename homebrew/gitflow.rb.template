# Homebrew Formula for gitflow
# This file is auto-generated by the CI/CD pipeline on release.
# Manual changes will be overwritten on the next release.

class Gitflow < Formula
  desc "Git工作流自动化CLI工具 - 让团队开发更高效"
  homepage "https://github.com/{{GITHUB_REPOSITORY}}"
  version "{{VERSION}}"
  license "MIT"

  depends_on "git"

  on_macos do
    if Hardware::CPU.intel?
      url "https://github.com/{{GITHUB_REPOSITORY}}/releases/download/v{{VERSION}}/{{BIN_NAME}}-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{SHA256_MACOS_X86_64}}"
    elsif Hardware::CPU.arm?
      url "https://github.com/{{GITHUB_REPOSITORY}}/releases/download/v{{VERSION}}/{{BIN_NAME}}-{{VERSION}}-macos-aarch64.tar.gz"
      sha256 "{{SHA256_MACOS_ARM64}}"
    end
  end

  on_linux do
    if Hardware::CPU.intel?
      url "https://github.com/{{GITHUB_REPOSITORY}}/releases/download/v{{VERSION}}/{{BIN_NAME}}-{{VERSION}}-linux-x86_64.tar.gz"
      sha256 "{{SHA256_LINUX_X86_64}}"
    elsif Hardware::CPU.arm?
      url "https://github.com/{{GITHUB_REPOSITORY}}/releases/download/v{{VERSION}}/{{BIN_NAME}}-{{VERSION}}-linux-aarch64.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
  end

  def install
    bin.install "{{BIN_NAME}}"

    # Install shell completions if available
    if build.head?
      bash_completion.install "completions/completions.bash" => "{{BIN_NAME}}"
      zsh_completion.install "completions/completions.zsh" => "_{{BIN_NAME}}"
      fish_completion.install "completions/completions.fish" => "{{BIN_NAME}}.fish"
    end
  end

  test do
    # Basic version check
    assert_match "gitflow #{version}", shell_output("#{bin}/{{BIN_NAME}} --version")

    # Test help output
    assert_match "Git工作流自动化CLI工具", shell_output("#{bin}/{{BIN_NAME}} --help")

    # Test config subcommand exists
    assert_match "配置管理", shell_output("#{bin}/{{BIN_NAME}} config --help")
  end

  def caveats
    <<~EOS
      gitflow requires Git to be installed.
      For the best experience, make sure you're in a Git repository directory.

      Configuration:
        - Global config: ~/.config/gitflow/config.toml
        - Project config: .gitflow.toml in your repository root

      Run `gitflow config init` to create a default configuration.
    EOS
  end
end
