        },
        "defaultPreset": "day"
      },
      "rendering": {
        "qualityPresets": {
          "low": {
            "name": "低",
            "shadowMapSize": 1024,
            "pixelRatio": 1,
            "ssaoEnabled": false,
            "antialias": false
          },
          "medium": {
            "name": "中",
            "shadowMapSize": 2048,
            "pixelRatio": 1,
            "ssaoEnabled": true,
            "ssaoSamples": 16,
            "antialias": true
          },
          "high": {
            "name": "高",
            "shadowMapSize": 4096,
            "pixelRatio": 2,
            "ssaoEnabled": true,
            "ssaoSamples": 32,
            "antialias": true
          }
        },
        "defaultQuality": "medium",
        "toneMapping": "ACESFilmic",
        "backgroundColor": "#1a1f2e",
        "fogColor": "#1a1f2e",
        "fogNear": 20,
        "fogFar": 50
      }
    },
