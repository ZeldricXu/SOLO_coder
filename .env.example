APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/profilerhub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

TIMESERIES_ENGINE=influxdb
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=profilerhub
INFLUXDB_BUCKET=metrics

LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=true
