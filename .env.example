APP_NAME=db-pool-platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/appdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CONFIG_FILE=./config/config.yaml
CONFIG_WATCH_ENABLED=true

STORAGE_LOCAL_PATH=./storage
STORAGE_PROVIDER=local

METRICS_ENABLED=true
METRICS_PORT=9090

LOG_LEVEL=INFO
LOG_FORMAT=json

TRACE_ENABLED=true
TRACE_EXPORTER=console

SBOM_CVE_DB_PATH=./data/cve_db.json
QUALITY_RULES_PATH=./config/quality_rules.yaml
