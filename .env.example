CLOUDCI_LOG_LEVEL=info
CLOUDCI_LOG_FORMAT=json

CLOUDCI_SERVER_HOST=0.0.0.0
CLOUDCI_SERVER_PORT=8080
CLOUDCI_SERVER_MODE=release

CLOUDCI_DB_HOST=localhost
CLOUDCI_DB_PORT=5432
CLOUDCI_DB_USER=cloudci
CLOUDCI_DB_PASSWORD=cloudci
CLOUDCI_DB_NAME=cloudci
CLOUDCI_DB_SSLMODE=disable
CLOUDCI_DB_MAX_OPEN_CONNS=100
CLOUDCI_DB_MAX_IDLE_CONNS=10

CLOUDCI_REDIS_HOST=localhost
CLOUDCI_REDIS_PORT=6379
CLOUDCI_REDIS_PASSWORD=
CLOUDCI_REDIS_DB=0
CLOUDCI_REDIS_POOL_SIZE=50

CLOUDCI_MINIO_ENDPOINT=localhost:9000
CLOUDCI_MINIO_ACCESS_KEY=minioadmin
CLOUDCI_MINIO_SECRET_KEY=minioadmin
CLOUDCI_MINIO_BUCKET=cloudci-artifacts
CLOUDCI_MINIO_SECURE=false

CLOUDCI_VAULT_ADDR=http://localhost:8200
CLOUDCI_VAULT_TOKEN=root
CLOUDCI_VAULT_SECRET_PATH=secret/cloudci

CLOUDCI_SCHEDULER_MAX_CONCURRENT=10
CLOUDCI_SCHEDULER_DEFAULT_TIMEOUT=3600
CLOUDCI_SCHEDULER_QUEUE_SIZE=1000

CLOUDCI_PLUGIN_DIR=./plugins
CLOUDCI_PLUGIN_REGISTRY_FILE=./plugins/registry.json

CLOUDCI_NOTIFICATION_DINGTALK_WEBHOOK=
CLOUDCI_NOTIFICATION_DINGTALK_SECRET=
CLOUDCI_NOTIFICATION_FEISHU_WEBHOOK=
CLOUDCI_NOTIFICATION_SLACK_WEBHOOK=
CLOUDCI_NOTIFICATION_SMTP_HOST=
CLOUDCI_NOTIFICATION_SMTP_PORT=587
CLOUDCI_NOTIFICATION_SMTP_USER=
CLOUDCI_NOTIFICATION_SMTP_PASSWORD=
CLOUDCI_NOTIFICATION_SMTP_FROM=

CLOUDCI_ARTIFACT_RETENTION_DAYS=30
CLOUDCI_LOG_RETENTION_DAYS=90

CLOUDCI_WEBHOOK_SECRET=cloudci-secret
