# ============================================================
# Contract Audit Platform - Environment Configuration
# Copy this file to .env and update the values as needed
# ============================================================

# ============================================================
# Application Configuration
# ============================================================
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080
MANAGEMENT_PORT=8081

# ============================================================
# MySQL Database Configuration
# ============================================================
MYSQL_ROOT_PASSWORD=contraudit2026!
MYSQL_DATABASE=contraudit
MYSQL_USER=contraudit
MYSQL_PASSWORD=contraudit2026!
MYSQL_HOST=localhost
MYSQL_PORT=3306

PROD_DB_URL=jdbc:mysql://prod-db.example.com:3306/contraudit_prod
PROD_DB_USER=contraudit_prod
PROD_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
TEST_DB_URL=jdbc:mysql://test-db.example.com:3306/contraudit_test
TEST_DB_USER=contraudit_test
TEST_DB_PASSWORD=CHANGE_ME

# ============================================================
# Redis Configuration
# ============================================================
REDIS_PASSWORD=contraudit2026!
REDIS_HOST=localhost
REDIS_PORT=6379

PROD_REDIS_HOST=prod-redis.example.com
PROD_REDIS_PORT=6379
PROD_REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
TEST_REDIS_HOST=test-redis.example.com
TEST_REDIS_PORT=6379
TEST_REDIS_PASSWORD=CHANGE_ME

# ============================================================
# Storage Configuration
# ============================================================
STORAGE_IPFS_GATEWAY=https://ipfs.infura.io:5001/api/v0
STORAGE_IPFS_API_KEY=your_ipfs_project_id
STORAGE_IPFS_API_SECRET=your_ipfs_project_secret

STORAGE_ARWEAVE_GATEWAY=https://arweave.net
STORAGE_ARWEAVE_WALLET=/path/to/arweave-wallet.json

# ============================================================
# Monitoring Configuration
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_RETENTION=30d

# ============================================================
# Docker Registry Configuration
# ============================================================
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your-github-username
DOCKER_PASSWORD=your-github-token

# ============================================================
# JVM Configuration
# ============================================================
JVM_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ============================================================
# Cloud Environment
# ============================================================
CLOUD_REGION=ap-east-1
ENVIRONMENT=dev
