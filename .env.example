# Application Configuration
APP_NAME=middleware-platform
APP_ENV=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./platform.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Gateway Configuration
API_GATEWAY_TIMEOUT=30
API_GATEWAY_RETRIES=3
API_GATEWAY_MAX_CONCURRENT=100

# Storage Configuration
STORAGE_BACKUP_PATH=./backups
STORAGE_DATA_PATH=./data

# Notification Configuration
NOTIFICATION_DEFAULT_CHANNEL=email

# GPU Configuration
GPU_TOTAL_MEMORY_GB=80
GPU_MAX_TASKS_PER_GPU=4

# Evaluation Configuration
DRIFT_DETECTION_THRESHOLD=0.05
METRICS_RETENTION_DAYS=30
