# ==================== 环境配置 ====================
# development | staging | production
ENVIRONMENT=development

# ==================== 数据库配置 ====================
DATABASE_URL=mysql+pymysql://root:monitor123@localhost:3306/monitor
MYSQL_ROOT_PASSWORD=monitor123
MYSQL_DATABASE=monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=monitor123

# ==================== Prometheus 配置 ====================
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# ==================== Elasticsearch 配置 ====================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_TIMEOUT=10
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ==================== 告警通知配置 ====================
# 钉钉
DINGTALK_WEBHOOK=

# 企业微信
WECHAT_WEBHOOK=

# 电话
PHONE_NOTIFY_URL=

# SMTP 邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alert@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alert@example.com
SMTP_TO_EMAILS=ops1@example.com,ops2@example.com
SMTP_CC_EMAILS=manager@example.com
SMTP_USE_TLS=true

# ==================== 服务配置 ====================
HEALTH_CHECK_INTERVAL=30
ALERT_EVALUATE_INTERVAL=60

# ==================== 部署配置 ====================
WORKERS=4
PORT=8080
HOST=0.0.0.0
