# ==================== Database Configuration ====================
DATABASE_URL=postgresql://postgres:password@localhost:5432/genome_variant_db

# ==================== Redis Configuration ====================
REDIS_URL=redis://localhost:6379/0

# ==================== MinIO Configuration ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_DATA_BUCKET=raw-sequencing-data
MINIO_RESULTS_BUCKET=analysis-results
MINIO_REPORTS_BUCKET=clinical-reports

# ==================== Celery Configuration ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==================== Tool Paths ====================
TOOL_FASTQC=/usr/bin/fastqc
TOOL_FASTP=/usr/bin/fastp
TOOL_BWA=/usr/bin/bwa
TOOL_SAMTOOLS=/usr/bin/samtools
TOOL_PICARD=/usr/bin/picard.jar
TOOL_GATK=/usr/bin/gatk
TOOL_VARDICT=/usr/bin/vardict
TOOL_VEP=/usr/bin/vep

# ==================== Reference Genome ====================
HG38_FASTA=/reference/hg38/Homo_sapiens_assembly38.fasta
HG38_FASTA_INDEX=/reference/hg38/Homo_sapiens_assembly38.fasta.fai
HG38_BWA_INDEX=/reference/hg38/Homo_sapiens_assembly38
HG38_DBSNP=/reference/hg38/dbsnp_155.hg38.vcf.gz
HG38_KNOWN_INDELS_1000G=/reference/hg38/1000G_phase1.snps.high_confidence.hg38.vcf.gz
HG38_KNOWN_INDELS_MILLS=/reference/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz

# ==================== Annotation Databases ====================
DBNSFP_DATABASE=/annotation/dbNSFP4.5a_grch38.gz
DBNSFP_SORTED=/annotation/dbNSFP4.5a_grch38.sorted.gz
DBNSFP_TBI=/annotation/dbNSFP4.5a_grch38.sorted.gz.tbi
CLINVAR_DATABASE=/annotation/clinvar_20240107.vcf.gz
CLINVAR_TBI=/annotation/clinvar_20240107.vcf.gz.tbi

# ==================== Retention Policy ====================
RETENTION_RAW_FASTQ_DAYS=90
RETENTION_BAM_DAYS=180
RETENTION_GVCF_DAYS=-1
RETENTION_REPORT_DAYS=-1

# ==================== Pipeline Settings ====================
PIPELINE_WORK_DIR=/data/work
PIPELINE_MAX_PARALLEL=4
PIPELINE_MAX_RETRIES=3
