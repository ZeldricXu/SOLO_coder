APP_NAME=EdgeIoTPlatform
APP_VERSION=1.1.0
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///./edge_iot.db
DATABASE_SYNC_URL=sqlite:///./edge_iot.db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STRICT=10/minute

STORAGE_BASE_PATH=./storage
BACKUP_PATH=./storage/backups
FIRMWARE_PATH=./storage/firmware
MODELS_PATH=./storage/models

LOG_LEVEL=INFO

OTA_MAX_RETRIES=3
OTA_GRAYSCALE_BATCH_SIZE=10

DEVICE_SHADOW_MAX_CONCURRENT=100
DEVICE_SHADOW_QUEUE_TIMEOUT=30
DEVICE_SHADOW_RETRY_ATTEMPTS=3
DEVICE_SHADOW_RETRY_DELAY=1.0

CACHE_L1_TTL=60
CACHE_L2_TTL=300
CACHE_L3_TTL=3600
CACHE_L1_MAX_SIZE=1000
CACHE_L2_MAX_SIZE=5000
CACHE_ENABLED=true

AUTOSCALE_ENABLED=true
AUTOSCALE_MIN_INSTANCES=1
AUTOSCALE_MAX_INSTANCES=10
AUTOSCALE_TARGET_CPU=70.0
AUTOSCALE_TARGET_LATENCY=500
AUTOSCALE_COOLDOWN_PERIOD=60
AUTOSCALE_CHECK_INTERVAL=30

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
