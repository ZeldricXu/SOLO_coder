# NFTIndexer Environment Configuration

# Application Settings
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_ENABLE_DOCS=true
API_ENABLE_CORS=true
API_CORS_ORIGINS=*
API_REQUIRE_API_KEY=false
API_API_KEYS=your-api-key-1,your-api-key-2

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./nftindexer.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Settings
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=./logs/nftindexer.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5

# Chain RPC Settings - Ethereum Mainnet
CHAIN_1_NAME=Ethereum Mainnet
CHAIN_1_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_1_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_1_BLOCK_TIME=12
CHAIN_1_CONFIRMATIONS=6
CHAIN_1_TIMEOUT=30

# Chain RPC Settings - Goerli Testnet
CHAIN_5_NAME=Goerli Testnet
CHAIN_5_RPC_URL=https://eth-goerli.g.alchemy.com/v2/your-api-key
CHAIN_5_WS_URL=wss://eth-goerli.g.alchemy.com/v2/your-api-key
CHAIN_5_BLOCK_TIME=12
CHAIN_5_CONFIRMATIONS=6
CHAIN_5_TIMEOUT=30

# Chain RPC Settings - Polygon Mainnet
CHAIN_137_NAME=Polygon Mainnet
CHAIN_137_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_137_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_137_BLOCK_TIME=2
CHAIN_137_CONFIRMATIONS=10
CHAIN_137_TIMEOUT=30

# Chain RPC Settings - Arbitrum One
CHAIN_42161_NAME=Arbitrum One
CHAIN_42161_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_42161_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_42161_BLOCK_TIME=0.25
CHAIN_42161_CONFIRMATIONS=10
CHAIN_42161_TIMEOUT=30

# Storage Settings
STORAGE_IPFS_API_URL=http://localhost:5001
STORAGE_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
STORAGE_ARWEAVE_GATEWAY_URL=https://arweave.net/
STORAGE_DEFAULT_NETWORK=ipfs
STORAGE_AUTO_PIN=true

# HD Wallet Settings
HD_WALLET_DEFAULT_DERIVATION_PATH=m/44'/60'/0'/0/0
HD_WALLET_DEFAULT_CHAIN_ID=1

# ZKP Settings
ZKP_VERIFICATION_KEYS_DIR=./data/zkp-keys
ZKP_CACHE_ENABLED=true
ZKP_CACHE_TTL=3600

# Gas Estimator Settings
GAS_HISTORY_BLOCKS=100
GAS_CACHE_TTL=15
GAS_ORACLE_ENABLED=true

# Event Listener Settings
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY=1000
EVENT_BATCH_SIZE=100
EVENT_CALLBACK_TIMEOUT=30

# Cross-Chain Settings
CROSS_CHAIN_MIN_CONFIRMATIONS=10
CROSS_CHAIN_RELAYER_ADDRESS=0x...
CROSS_CHAIN_PROVER_ENABLED=true

# Observability Settings
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
HEALTH_CHECK_INTERVAL=30
