# Database
DATABASE_URL="postgresql://mlops:mlops123@localhost:5432/mlops_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET_MODELS="models"
S3_BUCKET_FEATURES="features"
S3_BUCKET_ARTIFACTS="artifacts"

# Storage Backend: s3 | local
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"

# Server
SERVER_HOST="0.0.0.0"
SERVER_PORT="3001"
GRPC_PORT="50051"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Inference
INFERENCE_BATCH_MAX_SIZE="32"
INFERENCE_BATCH_TIMEOUT_MS="10"
INFERENCE_CACHE_TTL_SECONDS="300"

# Monitoring
METRICS_RETENTION_DAYS="30"
DRIFT_DETECTION_INTERVAL_MINUTES="60"
DRIFT_THRESHOLD_P_VALUE="0.05"
