# ========================================
# 看板搭建器配置文件
# 复制此文件为 .env 并根据实际环境修改
# ========================================

# ========================================
# 应用环境
# development / staging / production / testing
# ========================================
FLASK_ENV=development

# ========================================
# 安全配置
# ========================================
# 生产环境请使用复杂随机字符串
SECRET_KEY=change-me-to-a-long-random-string-minimum-32-chars

# 数据源连接信息加密密钥
# 必须32字符，使用: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=change-me-to-32-char-url-safe-base64-key

# ========================================
# 数据库配置
# ========================================
# PostgreSQL (生产环境推荐)
DATABASE_URL=postgresql://dataflow:dataflow@localhost:5432/dataflow

# SQLite (开发环境可选)
# DATABASE_URL=sqlite:///data/dashboard.db

# MySQL (可选数据源)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dataflow
MYSQL_PASSWORD=dataflow
MYSQL_DATABASE=dataflow
MYSQL_ROOT_PASSWORD=rootpassword

# ========================================
# Redis配置
# ========================================
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_PASSWORD=redis_password

# Celery
CELERY_BROKER_URL=redis://:redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password@localhost:6379/2

# ========================================
# 邮件服务配置
# ========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# 开发环境可用 MailHog 替代
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=false

# ========================================
# 查询缓存配置 (秒)
# ========================================
CACHE_TTL_DEFAULT=300
CACHE_TTL_MYSQL=60
CACHE_TTL_CLICKHOUSE=30
CACHE_TTL_PROMETHEUS=15
CACHE_TTL_HTTP=60

# ========================================
# SSE 实时推送配置
# ========================================
SSE_HEARTBEAT_INTERVAL=15
MAX_SSE_CONNECTIONS=1000

# ========================================
# 外部分享链接配置
# ========================================
SHARE_LINK_EXPIRY_HOURS=24
MAX_SHARE_LINK_EXPIRY_DAYS=30

# ========================================
# Gunicorn (生产环境)
# ========================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
WEB_PORT=5000

# ========================================
# Celery Worker 配置
# ========================================
CELERY_CONCURRENCY=2

# ========================================
# Playwright 截图配置
# ========================================
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# ========================================
# Docker 镜像配置
# ========================================
IMAGE_REPO=dataflow-dashboard
IMAGE_TAG=latest

# ========================================
# 环境说明
# ========================================
# development:
#   - 开启 DEBUG 模式
#   - 自动重载代码
#   - SQLite 数据库
#   - 日志级别 DEBUG
#
# staging:
#   - 关闭 DEBUG 模式
#   - PostgreSQL 数据库
#   - 完整功能测试
#   - 日志级别 INFO
#
# production:
#   - 关闭 DEBUG 模式
#   - PostgreSQL 数据库
#   - 启用全部安全措施
#   - 日志级别 WARNING
#   - Gunicorn + 多 Worker
