NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_platform?schema=public

TENANT_DATABASE_URL_TEMPLATE=postgresql://postgres:postgres@localhost:5432/cms_tenant_{tenantId}

REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER=false

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

BULLMQ_REDIS_URL=redis://localhost:6379/1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

CDN_BASE_URL=https://cdn.example.com
CDN_API_KEY=your-cdn-api-key
CDN_PROVIDER=aliyun|qiniu|cloudflare

LOG_LEVEL=info
LOG_PRETTY=true
