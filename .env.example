APP_ENV=development

SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_JWT_SECRET=your-jwt-secret-here

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=inference_platform
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

TRITON_GRPC_HOST=localhost
TRITON_GRPC_PORT=8001
TRITON_HTTP_PORT=8000
TRITON_MODEL_REPOSITORY_PATH=./model-store

ORCHESTRATOR_RUNTIME_MODE=docker
ORCHESTRATOR_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.01-py3
ORCHESTRATOR_MODEL_REPOSITORY_HOST_PATH=./model-store
ORCHESTRATOR_HEALTH_CHECK_INTERVAL=3s
ORCHESTRATOR_HEALTH_CHECK_INFERENCE=true
ORCHESTRATOR_MIN_REPLICAS=1
ORCHESTRATOR_MAX_REPLICAS=10

MONITORING_PROMETHEUS_PORT=9090
MONITORING_LOG_LEVEL=info

WEBHOOK_ENABLED=true
WEBHOOK_AUTH_TOKEN=your-webhook-auth-token

NOTIFICATION_DINGTALK_ENABLED=false
NOTIFICATION_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
NOTIFICATION_DINGTALK_SECRET=your-dingtalk-secret

NOTIFICATION_WECHAT_WORK_ENABLED=false
NOTIFICATION_WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=inference-models

GRAFANA_PASSWORD=admin123
