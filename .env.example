# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/didauth?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Blockchain RPC Configuration
ETH_RPC_URL=https://mainnet.infura.io/v3/your-project-id
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Wallet Configuration
HD_WALLET_MNEMONIC=your twelve word mnemonic phrase here twelve
HD_WALLET_PASSPHRASE=

# Storage Configuration
IPFS_GATEWAY_URL=https://ipfs.infura.io:5001
IPFS_API_KEY=
IPFS_API_SECRET=
ARWEAVE_KEY=path/to/arweave-keyfile.json

# Cross-Chain Bridge Configuration
BRIDGE_CONTRACT_ADDRESS=0x...
RELAYER_PRIVATE_KEY=

# Multisig Configuration
MULTISIG_THRESHOLD=2
MULTISIG_OWNERS=0x...,0x...

# Security Configuration
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-here
