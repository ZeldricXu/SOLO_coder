# ========================================
# 应用基础配置
# ========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_WORKERS=1
APP_NAME=ticket-routing-system

# ========================================
# 安全配置
# ========================================
SECRET_KEY=change-me-in-production-please-use-a-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# API 配置
# ========================================
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ========================================
# 数据库配置
# ========================================
DATABASE_URL=sqlite+aiosqlite:///./app.db
SYNC_DATABASE_URL=sqlite:///./app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ========================================
# Redis 配置
# ========================================
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=20

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========================================
# 限流配置
# ========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ========================================
# 监控配置
# ========================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
METRICS_ENABLED=true
METRICS_PORT=9090

# ========================================
# 功能开关
# ========================================
FEATURE_FLAG_SKILL_MATCHING=true
FEATURE_FLAG_LOAD_BALANCING=true
FEATURE_FLAG_AUTO_ASSIGNMENT=true
