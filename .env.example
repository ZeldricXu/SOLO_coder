# GameStats 环境变量配置示例文件
# 复制此文件为 .env 并修改为实际配置

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_PASSWORD=your_secure_mysql_password

# InfluxDB 配置
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=your_secure_influxdb_password
INFLUXDB_TOKEN=your_secure_influxdb_admin_token

# Redis 配置
REDIS_PASSWORD=your_secure_redis_password

# 服务端口配置（可选，修改后需要同时修改 docker-compose.yml）
# EVENT_ACCESS_PORT=8080
# PROFILE_SERVICE_PORT=8002
# DASHBOARD_PORT=3000
