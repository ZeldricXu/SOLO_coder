APP_NAME=enterprise_platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=info

RUST_LOG=enterprise_platform=debug,tower_http=debug,axum=info

DATABASE_URL=postgres://user:password@localhost:5432/enterprise
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=30

REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=20
REDIS_PASSWORD=

MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=http://localhost:9000/alerts
ALERT_EMAIL_FROM=alerts@platform.example.com
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=alerts
ALERT_EMAIL_PASSWORD=

TEE_ENABLED=false
TEE_TYPE=sgx
TEE_SIMULATION=true

SHAMIR_THRESHOLD=3
SHAMIR_TOTAL_SHARES=5
SHAMIR_KEYSTORE_PATH=/var/lib/enterprise_platform/shares

AUDIT_LOG_PATH=/var/log/enterprise_platform/audit.log
AUDIT_LOG_MAX_SIZE=104857600
AUDIT_LOG_MAX_FILES=10

MASKING_ENABLED=true
MASKING_DEFAULT_PATTERN=****

RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRE_HOURS=24

API_GATEWAY_TIMEOUT=30
API_GATEWAY_MAX_BODY_SIZE=10485760

TRACE_ID_HEADER=x-trace-id
SIGNATURE_HEADER=x-signature
TIMESTAMP_HEADER=x-timestamp
TIMESTAMP_MAX_AGE=300
