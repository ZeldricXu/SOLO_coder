APP_NAME=task-orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_ARCHIVE_DIR=./logs/archive

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/taskdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=task-orchestrator
S3_REGION=us-east-1

NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5
NOTIFICATION_TIMEOUT=30

SCHEDULER_MAX_WORKERS=10
SCHEDULER_TASK_TIMEOUT=3600

QUALITY_GATE_THRESHOLD_COMPLEXITY=10
QUALITY_GATE_THRESHOLD_COVERAGE=80.0
QUALITY_GATE_THRESHOLD_DUPLICATION=5.0
