# ========================================
# 环境变量配置示例
# 复制为 .env 文件并根据实际环境修改
# ========================================

# ---------- 运行环境 ----------
RUST_ENV=development
RUST_LOG=info,data_transformer=debug

# ---------- 服务配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---------- 数据库配置 ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/data_transformer
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=300

# ---------- Redis配置 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_CONNECT_TIMEOUT=3
REDIS_IDLE_TIMEOUT=300

# ---------- 日志配置 ----------
LOG_DIR=./logs
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
LOG_COMPRESSION=true

# ---------- JWT配置 ----------
JWT_SECRET=change-me-to-a-very-long-random-secret-key-please
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800
JWT_ALGORITHM=HS256

# ---------- 限流配置 ----------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000
RATE_LIMIT_BURST=50

# ---------- 缓存配置 ----------
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=10000
CACHE_EVICTION_POLICY=lru

# ---------- 监控配置 ----------
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics
OTLP_ENDPOINT=http://localhost:4317/v1/traces

# ---------- 熔断器配置 ----------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=10

# ---------- Sidecar配置 ----------
SIDECAR_CPU_LIMIT=500m
SIDECAR_MEMORY_LIMIT=256Mi
SIDECAR_INJECTION_MODE=manual

# ---------- 调度配置 ----------
SCHEDULER_ENABLED=true
SCHEDULER_THREAD_POOL_SIZE=4

# ---------- 故障注入配置 ----------
FAULT_INJECTION_ENABLED=false
FAULT_INJECTION_PROBABILITY=0.01
