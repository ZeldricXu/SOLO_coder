APP_NAME=cloud-native-engine
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_SYNC_URL=sqlite:///./app.db

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=

NOTIFICATION_EMAIL_HOST=smtp.example.com
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_WEBHOOK_URL=

EVENT_STORE_BACKEND=sqlalchemy
SNAPSHOT_INTERVAL=100
SNAPSHOT_RETENTION=7

TASK_BROKER_URL=redis://localhost:6379/1
TASK_RESULT_BACKEND=redis://localhost:6379/2
