# ========================================
# Environment selector
# ========================================
APP_ENV=development

# ========================================
# Server
# ========================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
BASE_URL=http://localhost:8080
APP__SERVER__HOST=127.0.0.1
APP__SERVER__PORT=8080
APP__SERVER__BASE_URL=http://localhost:8080

# ========================================
# Database (PostgreSQL)
# ========================================
DATABASE_URL=postgres://df169:df169secret@localhost:5432/df1_69
APP__DATABASE__URL=postgres://df169:df169secret@localhost:5432/df1_69
APP__DATABASE__HOST=localhost
APP__DATABASE__PORT=5432
APP__DATABASE__USER=df169
APP__DATABASE__PASSWORD=df169secret
APP__DATABASE__NAME=df1_69
APP__DATABASE__MAX_CONNECTIONS=20
APP__DATABASE__MIN_CONNECTIONS=5
APP__DATABASE__ACQUIRE_TIMEOUT_SECS=30
APP__DATABASE__IDLE_TIMEOUT_SECS=300

# ========================================
# Redis
# ========================================
REDIS_URL=redis://:df169redissecret@localhost:6379/0
APP__REDIS__URL=redis://:df169redissecret@localhost:6379/0
APP__REDIS__MAX_CONNECTIONS=50
APP__REDIS__MIN_CONNECTIONS=10

# ========================================
# MinIO (S3-compatible object storage)
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminsecret
MINIO_BUCKET=df1-69
APP__MINIO__ENDPOINT=localhost:9000
APP__MINIO__ACCESS_KEY=minioadmin
APP__MINIO__SECRET_KEY=minioadminsecret
APP__MINIO__BUCKET_NAME=df1-69
APP__MINIO__REGION=us-east-1
APP__MINIO__USE_SSL=false

# ========================================
# OAuth Providers
# ========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
APP__OAUTH__GITHUB__CLIENT_ID=your_github_client_id
APP__OAUTH__GITHUB__CLIENT_SECRET=your_github_client_secret
APP__OAUTH__GITHUB__AUTH_URL=https://github.com/login/oauth/authorize
APP__OAUTH__GITHUB__TOKEN_URL=https://github.com/login/oauth/access_token
APP__OAUTH__GITHUB__API_BASE_URL=https://api.github.com
APP__OAUTH__GITHUB__REDIRECT_URL=http://localhost:8080/auth/github/callback

GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
APP__OAUTH__GITLAB__CLIENT_ID=your_gitlab_client_id
APP__OAUTH__GITLAB__CLIENT_SECRET=your_gitlab_client_secret
APP__OAUTH__GITLAB__AUTH_URL=https://gitlab.com/oauth/authorize
APP__OAUTH__GITLAB__TOKEN_URL=https://gitlab.com/oauth/token
APP__OAUTH__GITLAB__API_BASE_URL=https://gitlab.com/api/v4
APP__OAUTH__GITLAB__REDIRECT_URL=http://localhost:8080/auth/gitlab/callback

GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
APP__OAUTH__GITEE__CLIENT_ID=your_gitee_client_id
APP__OAUTH__GITEE__CLIENT_SECRET=your_gitee_client_secret
APP__OAUTH__GITEE__AUTH_URL=https://gitee.com/oauth/authorize
APP__OAUTH__GITEE__TOKEN_URL=https://gitee.com/oauth/token
APP__OAUTH__GITEE__API_BASE_URL=https://gitee.com/api/v5
APP__OAUTH__GITEE__REDIRECT_URL=http://localhost:8080/auth/gitee/callback

# ========================================
# LLM (AI Review)
# ========================================
LLM_API_KEY=your_llm_api_key
APP__LLM__PROVIDER=openai
APP__LLM__API_KEY=your_llm_api_key
APP__LLM__API_BASE_URL=https://api.openai.com/v1
APP__LLM__MODEL=gpt-4o-mini
APP__LLM__MAX_TOKENS=4096
APP__LLM__TEMPERATURE=0.3
APP__LLM__TIMEOUT_SECS=120

# ========================================
# Email (SMTP)
# ========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
APP__EMAIL__SMTP_HOST=smtp.example.com
APP__EMAIL__SMTP_PORT=587
APP__EMAIL__SMTP_USERNAME=your_email@example.com
APP__EMAIL__SMTP_PASSWORD=your_email_password
APP__EMAIL__FROM_ADDRESS=noreply@example.com
APP__EMAIL__FROM_NAME="DF1-69 Code Review"
APP__EMAIL__USE_TLS=true

# ========================================
# Notifications (IM)
# ========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token
DINGTALK_SECRET=your_dingtalk_secret
APP__SLACK__WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
APP__DINGTALK__WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token
APP__DINGTALK__SECRET=your_dingtalk_secret

# ========================================
# Session
# ========================================
SESSION_SECRET_KEY=change-me-to-a-long-random-secret-key-please-use-openssl-rand-base64-48
SESSION_TTL_SECS=86400
APP__SESSION__SECRET_KEY=change-me-to-a-long-random-secret-key-please-use-openssl-rand-base64-48
APP__SESSION__TTL_SECS=86400
APP__SESSION__COOKIE_NAME=df169_session
APP__SESSION__COOKIE_SECURE=false
APP__SESSION__COOKIE_HTTP_ONLY=true

# ========================================
# App
# ========================================
APP_NAME="DF1-69 Code Review Platform"
LOG_LEVEL=debug
DAILY_DIGEST_CRON=0 0 9 * * *
APP__APP__NAME="DF1-69 Code Review Platform"
APP__APP__LOG_LEVEL=debug
APP__APP__ENVIRONMENT=development
APP__APP__WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
APP__APP__DAILY_DIGEST_CRON=0 0 9 * * *

# ========================================
# SQLX (dev only)
# ========================================
# SQLX_OFFLINE=true
# DATABASE_URL must be set when building release in offline mode
# Run: cargo sqlx prepare --workspace -- --database-url $DATABASE_URL
