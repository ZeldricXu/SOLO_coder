APP_NAME=DocumentUnderstandingPipeline
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=your-secret-key-here-change-in-production

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/doc_understanding
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@localhost:5432/doc_understanding

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-documents
MINIO_PROCESSED_BUCKET=processed-documents
MINIO_MODEL_BUCKET=model-artifacts

OCR_LANGS=ch,en
OCR_USE_GPU=false
OCR_DET_MODEL_DIR=
OCR_REC_MODEL_DIR=
OCR_CLS_MODEL_DIR=

ML_MODEL_CACHE_DIR=./.model_cache
ML_DEVICE=cpu
ML_BATCH_SIZE=4
ML_MAX_SEQ_LENGTH=512

EXTRACTION_MODEL_NAME=qwen-vl-chat
EXTRACTION_MODEL_VERSION=1.0.0
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

LAYOUT_MODEL_NAME=layoutlmv3-base
LAYOUT_MODEL_VERSION=1.0.0

TABLE_MODEL_NAME=table-transformer-detection
TABLE_MODEL_VERSION=1.0.0

RATE_LIMIT_PER_MINUTE=100
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT=3600
TASK_PRIORITY_HIGH=0
TASK_PRIORITY_MEDIUM=5
TASK_PRIORITY_LOW=10

LOG_LEVEL=INFO
LOG_DIR=./logs

AB_TEST_ENABLED=true
AB_TEST_TRAFFIC_SPLIT='{"model_v1": 0.7, "model_v2": 0.3}'
AB_TEST_METRICS=extraction_accuracy,review_rate,processing_time

ICD10_CODES_FILE=./data/icd10_codes.json
