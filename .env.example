APP_ENV=development

LOGANALYZER_SERVER_HTTP_PORT=8080
LOGANALYZER_SERVER_GRPC_PORT=9090
LOGANALYZER_SERVER_METRICS_PORT=9091
LOGANALYZER_SERVER_LOG_LEVEL=info

LOGANALYZER_STORAGE_CLICKHOUSE_ADDRESSES=localhost:9000
LOGANALYZER_STORAGE_CLICKHOUSE_USERNAME=default
LOGANALYZER_STORAGE_CLICKHOUSE_PASSWORD=
LOGANALYZER_STORAGE_CLICKHOUSE_DATABASE=loganalyzer

LOGANALYZER_STORAGE_REDIS_ADDRESS=localhost:6379
LOGANALYZER_STORAGE_REDIS_PASSWORD=
LOGANALYZER_STORAGE_REDIS_DB=0

LOGANALYZER_STORAGE_KAFKA_BROKERS=localhost:9092

LOGANALYZER_CONSUL_ADDRESS=localhost:8500
LOGANALYZER_CONSUL_TOKEN=
LOGANALYZER_CONSUL_KV_PATH=loganalyzer/config

LOGANALYZER_NOTIFICATION_CHANNELS_DINGTALK_CONFIG_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
LOGANALYZER_NOTIFICATION_CHANNELS_DINGTALK_CONFIG_SECRET=SECxxx

LOGANALYZER_NOTIFICATION_CHANNELS_PAGERDUTY_CONFIG_ROUTING_KEY=your-routing-key
LOGANALYZER_NOTIFICATION_CHANNELS_PAGERDUTY_CONFIG_SERVICE_KEY=your-service-key

LOGANALYZER_NOTIFICATION_CHANNELS_WEBHOOK_CONFIG_URL=http://internal-alert-service/api/alerts
LOGANALYZER_NOTIFICATION_CHANNELS_WEBHOOK_CONFIG_HEADERS_AUTHORIZATION=Bearer xxx
