APP_ENV=development
APP_NAME=gas-estimator-platform
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gas_estimator
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=10

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your-api-key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your-api-key
BSC_RPC_URL=https://bsc-dataseed.binance.org/

IPFS_URL=http://localhost:5001
ARWEAVE_NODE_URL=https://arweave.net
ARWEAVE_WALLET_PATH=./arweave-wallet.json

HD_WALLET_MNEMONIC=your mnemonic phrase here
HD_WALLET_PASSPHRASE=
HD_WALLET_DERIVATION_PATH=m/44'/60'/0'/0

ZKP_CIRCUIT_PATH=./circuits
ZKP_VERIFICATION_KEY_PATH=./keys

LOG_LEVEL=INFO
LOG_FORMAT=json

METRICS_ENABLED=true
METRICS_PORT=9090

TRACING_ENABLED=true
TRACING_SERVICE_NAME=gas-estimator

RATE_LIMIT_PER_MINUTE=1000
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

GAS_HISTORY_DAYS=30
GAS_PREDICTION_MODEL=linear
GAS_CACHE_TTL=300

BRIDGE_CONFIRMATIONS=12
BRIDGE_RELEASE_DELAY=3600

EVENT_POLL_INTERVAL=15
EVENT_BATCH_SIZE=100
