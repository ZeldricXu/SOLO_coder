# ============================================
# Genome Pipeline Environment Configuration
# ============================================

# ---------- Database Settings ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genome_pipeline
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Redis Settings ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# ---------- MinIO Settings ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_DATA_BUCKET=raw-sequencing-data
MINIO_RESULTS_BUCKET=analysis-results
MINIO_REPORTS_BUCKET=clinical-reports

# ---------- Tool Paths ----------
TOOL_FASTQC=fastqc
TOOL_FASTP=fastp
TOOL_BWA=bwa
TOOL_SAMTOOLS=samtools
TOOL_PICARD=picard
TOOL_GATK=gatk
TOOL_VARDICT=vardict-java
TOOL_VEP=vep

# ---------- Reference Genome ----------
REF_HG38_FASTA=/data/reference/hg38/Homo_sapiens_assembly38.fasta
REF_HG38_DICT=/data/reference/hg38/Homo_sapiens_assembly38.dict
REF_HG38_BWA_INDEX=/data/reference/hg38/Homo_sapiens_assembly38.fasta
REF_KNOWN_SITES_SNP=/data/reference/hg38/dbsnp_146.hg38.vcf.gz
REF_KNOWN_SITES_INDEL=/data/reference/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
REF_KNOWN_SITES_1000G=/data/reference/hg38/1000G_phase1.snps.high_confidence.hg38.vcf.gz

# ---------- Annotation Databases ----------
ANNO_VEP_CACHE_DIR=/data/vep/cache
ANNO_VEP_ASSEMBLY=GRCh38
ANNO_DBNSFP_DB=/data/annotation/dbNSFP/dbNSFP4.3a.gz
ANNO_CLINVAR_VCF=/data/annotation/clinvar/clinvar_20240107.vcf.gz
ANNO_GNOMAD_VCF=/data/annotation/gnomad/gnomad.genomes.r4.0.sites.vcf.gz

# ---------- Retention Policy ----------
RETENTION_RAW_FASTQ_DAYS=90
RETENTION_BAM_DAYS=365
RETENTION_GVCF_DAYS=-1
RETENTION_REPORT_DAYS=-1

# ---------- Pipeline Settings ----------
PIPELINE_MAX_RETRIES=3
PIPELINE_MAX_PARALLEL_CHROMOSOMES=8
PIPELINE_WORK_DIR=/data/work
PIPELINE_TEMP_DIR=/tmp/pipeline
PIPELINE_LOG_DIR=/data/logs

# ---------- Environment ----------
ENVIRONMENT=development
