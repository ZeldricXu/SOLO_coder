# Application
APP_NAME=streamsql
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/streamsql.log

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/streamsql
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# API
API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=100
API_REQUEST_TIMEOUT=30

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_ENDPOINT=http://jaeger:4317

# Storage
DATA_DIR=data
ARCHIVE_DIR=data/archive
TEMP_DIR=data/tmp

# Feature flags
FEATURE_CDC_ENABLED=true
FEATURE_VECTOR_INDEX_ENABLED=true
FEATURE_QUALITY_CHECK_ENABLED=true
