# 应用配置
BCI_APP_NAME="blockchain-infra"
BCI_APP_VERSION="1.0.0"
BCI_APP_HOST="0.0.0.0"
BCI_APP_PORT=8000
BCI_APP_DEBUG=false

# 链配置
BCI_CHAINS__ETHEREUM__RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-api-key"
BCI_CHAINS__ETHEREUM__CHAIN_ID=1
BCI_CHAINS__ETHEREUM__NAME="Ethereum Mainnet"

BCI_CHAINS__GOERLI__RPC_URL="https://eth-goerli.g.alchemy.com/v2/your-api-key"
BCI_CHAINS__GOERLI__CHAIN_ID=5
BCI_CHAINS__GOERLI__NAME="Ethereum Goerli"

BCI_CHAINS__POLYGON__RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/your-api-key"
BCI_CHAINS__POLYGON__CHAIN_ID=137
BCI_CHAINS__POLYGON__NAME="Polygon Mainnet"

# 数据库配置
BCI_DATABASE__URL="sqlite:///./data/blockchain_infra.db"
BCI_DATABASE__ECHO=false

# Redis配置
BCI_REDIS__HOST="localhost"
BCI_REDIS__PORT=6379
BCI_REDIS__DB=0

# Celery配置
BCI_CELERY__BROKER_URL="redis://localhost:6379/0"
BCI_CELERY__RESULT_BACKEND="redis://localhost:6379/0"

# IPFS配置
BCI_STORAGE__IPFS__API_URL="http://localhost:5001"
BCI_STORAGE__IPFS__GATEWAY_URL="https://ipfs.io/ipfs/"

# Arweave配置
BCI_STORAGE__ARWEAVE__NODE_URL="https://arweave.net"
BCI_STORAGE__ARWEAVE__GATEWAY_URL="https://arweave.net/"

# Gas预估配置
BCI_GAS_ESTIMATOR__HISTORY_BLOCKS=100
BCI_GAS_ESTIMATOR__PRIORITY_FEE_PERCENTILE=60
BCI_GAS_ESTIMATOR__MAX_PRIORITY_FEE=50000000000
BCI_GAS_ESTIMATOR__GAS_PRICE_MULTIPLIER=1.2

# 事件监听配置
BCI_EVENT_LISTENER__MAX_RETRY=3
BCI_EVENT_LISTENER__RETRY_DELAY=5
BCI_EVENT_LISTENER__POLL_INTERVAL=2
BCI_EVENT_LISTENER__CONFIRMATION_BLOCKS=12

# 索引器配置
BCI_INDEXER__BATCH_SIZE=100
BCI_INDEXER__START_BLOCK=0
BCI_INDEXER__CONCURRENT_WORKERS=4

# 钱包配置
BCI_WALLET__HD_PATH="m/44'/60'/0'/0"
BCI_WALLET__DEFAULT_CHAIN="ethereum"
