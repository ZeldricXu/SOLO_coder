NODE_ENV=development
PORT=3000

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

DATABASE_URL=postgresql://user:password@localhost:5432/auth_gateway
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=30000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

CONFIG_FILE_PATH=./config/config.json
CONFIG_REDIS_KEY=auth_gateway:config
CONFIG_POLL_INTERVAL=30000

BACKUP_PATH=./backups
BACKUP_SCHEDULE=0 2 * * *

BILLING_CYCLE_DAYS=30
PRICE_PER_API_CALL=0.001
PRICE_PER_STORAGE_GB=0.05
PRICE_PER_COMPUTE_UNIT=0.02
