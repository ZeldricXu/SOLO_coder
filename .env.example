# Environment
NODE_ENV=development

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_ISSUER=metricplatform

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Storage Configuration
STORAGE_TYPE=memory
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=metricplatform

# Profiling
CPU_SAMPLING_INTERVAL=10
MEMORY_SAMPLING_INTERVAL=1000
MAX_PROFILE_DURATION=300000

# Notification
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=5000
EMAIL_ENABLED=false
WEBHOOK_ENABLED=true
SLACK_ENABLED=false

# Metrics
METRICS_WINDOW=60000
METRICS_MAX_POINTS=10000
METRICS_STORAGE=memory
