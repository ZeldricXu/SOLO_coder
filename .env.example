GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=4
GATEWAY_LOG_LEVEL=info
GATEWAY_REQUEST_TIMEOUT=30.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=gateway
CLICKHOUSE_SECURE=false

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_ISSUER=api-gateway
JWT_AUDIENCE=gateway-api

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_BURST_MULTIPLIER=2.0

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_SLOW_REQUEST_THRESHOLD=5.0
CIRCUIT_BREAKER_SLOW_REQUEST_RATE=0.5
CIRCUIT_BREAKER_OPEN_TIMEOUT=30
CIRCUIT_BREAKER_HALF_OPEN_LIMIT=5
CIRCUIT_BREAKER_WINDOW_SIZE=60

ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=5

AUTH_STRATEGIES='[
  {"path_prefix": "/api/internal", "strategy": "mtls"},
  {"path_prefix": "/api/public", "strategy": "jwt", "idp": "default"},
  {"path_prefix": "/api/admin", "strategy": "api_key"}
]'
