# Server
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=60

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=knowledgebase
POSTGRES_SSLMODE=disable
POSTGRES_MAX_IDLE=10
POSTGRES_MAX_OPEN=50
POSTGRES_AUTO_MIGRATE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=kb-documents

# Bleve Search
BLEVE_INDEX_BASE_PATH=./data/bleve-indexes
BLEVE_TIKA_ENDPOINT=http://localhost:9998
BLEVE_TIKA_TIMEOUT_SECONDS=30
BLEVE_DEFAULT_ANALYZER=zh_standard

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key-please-8f3a9c2e
JWT_EXPIRES_HOURS=24
JWT_ISSUER=kb-enterprise
JWT_AUDIENCE=kb-api

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Tenant-ID,X-Tenant-Namespace,X-Requested-With

# OT Configuration
OT_BUFFER_SIZE=100
OT_FLUSH_INTERVAL_MS=5000
OT_MAX_VERSION_GAP=50
