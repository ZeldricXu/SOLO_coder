# Server Configuration
SERVER_PORT=8080
SERVER_MODE=release

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=edgevision
DB_PASSWORD=edgevision_secret
DB_NAME=edgevision
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Inference Configuration
INFERENCE_WORKERS=4
INFERENCE_DEFAULT_STRATEGY=realtime

# Protocol Adapter Configuration
PROTOCOL_WORKERS=4

# Cache Configuration
CACHE_PATH=./data/cache
CACHE_MAX_SIZE_MB=100
CACHE_MAX_ENTRIES=10000

# OTA Configuration
OTA_WORKERS=2

# Aggregation Configuration
AGGREGATION_MAX_RESULTS=1000

# Lifecycle Configuration
LIFECYCLE_SECRET_KEY=edgevision-secret-key-change-in-production
LIFECYCLE_HEARTBEAT_TIMEOUT_SECONDS=180

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
TRACING_ENABLED=false
