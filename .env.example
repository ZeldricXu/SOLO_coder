RUST_LOG=info,edge_scheduler=debug
RUST_BACKTRACE=1

APP_ENV=development
APP_NAME=edge-scheduler
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edge_scheduler
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=30

REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_CONNECT_TIMEOUT=5

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=3600

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=edge-scheduler
OTEL_SERVICE_VERSION=0.1.0

CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL=30
CLOUD_API_ENDPOINT=https://api.example.com/v1
CLOUD_API_KEY=your-cloud-api-key

MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=edge-scheduler
MQTT_USERNAME=admin
MQTT_PASSWORD=admin

HEALTH_CHECK_INTERVAL=30
GRACEFUL_SHUTDOWN_TIMEOUT=30

MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60
