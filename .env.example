# Application Environment
SPRING_PROFILES_ACTIVE=docker
APP_VERSION=1.0.0

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=nft_indexer
MYSQL_USER=nftindexer
MYSQL_PASSWORD=nftindexer123

# Redis Configuration
REDIS_PASSWORD=

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# JVM Configuration
JAVA_OPTS=-Xms512m -Xmx1024m

# Docker Registry
DOCKER_REGISTRY=registry.example.com
DOCKER_IMAGE_PREFIX=nftindexer

# CI/CD Configuration
CI_PROJECT_NAME=nft-indexer
CI_COMMIT_TAG=latest

# SonarQube Configuration
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=nftindexer
SONAR_PROJECT_KEY=nft-indexer
