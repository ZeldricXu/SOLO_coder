# Application
APP_NAME=WalletHub
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-super-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./wallethub.db
DATABASE_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# IPFS
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_URL=http://localhost:5001
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key

# Arweave
ARWEAVE_GATEWAY_URL=https://arweave.net/
ARWEAVE_WALLET_PATH=./arweave-wallet.json

# RPC Endpoints
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_SEPOLIA=https://rpc.sepolia.org
RPC_POLYGON=https://polygon.llamarpc.com
RPC_BSC=https://bsc-dataseed.binance.org

# Feature Flags
GAS_ESTIMATE_BLOCKS=100
GAS_ESTIMATE_PERCENTILE=50
EVENT_LISTENER_POLL_INTERVAL=2.0
MAX_CONCURRENT_TASKS=100
