root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_size = 4
indent_style = tab

[*.yaml]
indent_size = 2
indent_style = space

[*.yml]
indent_size = 2
indent_style = space

[*.json]
indent_size = 2
indent_style = space

[*.md]
indent_size = 4
indent_style = space
trim_trailing_whitespace = false

[*.sh]
indent_size = 4
indent_style = space

[Makefile]
indent_size = 4
indent_style = tab

[.git*]
indent_size = 2
indent_style = space
