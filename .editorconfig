root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
jdt_java_import_order = java;javax;org;com
ij_java_imports_layout = *,|,java.**,javax.**,org.**,com.**

[*.xml]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.js]
indent_size = 2

[*.css]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Dockerfile]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[.github/workflows/*.yml]
indent_size = 2
