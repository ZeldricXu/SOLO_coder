root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_size = 4
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.yml]
[*.yaml]
indent_size = 2

[*.makefile]
[Makefile]
indent_style = tab

[*.sh]
indent_size = 4
end_of_line = lf

[*.dockerfile]
[Dockerfile]
indent_size = 4

[.git*]
indent_size = 4
