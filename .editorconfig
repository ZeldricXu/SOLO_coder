root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 150

[*.java]
indent_size = 4
continuation_indent_size = 8

[*.xml]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.properties]
indent_size = 1

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
tab_width = 4

[Dockerfile]
indent_size = 4

[*.sh]
indent_size = 4
end_of_line = lf
