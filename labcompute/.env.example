PROJECT_NAME=LabCompute
VERSION=1.0.0

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labcompute

DATA_DIR=data
REPORTS_DIR=reports

MAX_TASK_PRIORITY=10
DEFAULT_TASK_PRIORITY=5
TASK_TIMEOUT=3600

CONVERGENCE_THRESHOLD=10000000000.0
MAX_MATRIX_SIZE=10000
