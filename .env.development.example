NODE_ENV=development

SERVER_PORT=3000
SERVER_HOST=0.0.0.0

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_ISSUER=metricplatform-dev

RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

LOG_LEVEL=debug
LOG_PRETTY=true

STORAGE_TYPE=memory

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=metricplatform-dev

CPU_SAMPLING_INTERVAL=10
MEMORY_SAMPLING_INTERVAL=1000
MAX_PROFILE_DURATION=300000

NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=5000

EMAIL_ENABLED=false
WEBHOOK_ENABLED=false
SLACK_ENABLED=false

METRICS_WINDOW=60000
METRICS_MAX_POINTS=10000
METRICS_STORAGE=memory
