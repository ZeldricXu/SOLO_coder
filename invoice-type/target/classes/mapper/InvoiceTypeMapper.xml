<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.invoice.mgmt.type.mapper.InvoiceTypeMapper">
    <resultMap id="InvoiceTypeResultMap" type="com.invoice.mgmt.common.entity.InvoiceType">
        <id property="typeId" column="type_id"/>
        <result property="typeCode" column="type_code"/>
        <result property="typeName" column="type_name"/>
        <result property="taxRate" column="tax_rate"/>
        <result property="enabled" column="enabled"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO t_invoice_type (type_id, type_code, type_name, tax_rate, enabled, description, created_at, updated_at)
        VALUES (#{typeId}, #{typeCode}, #{typeName}, #{taxRate}, #{enabled}, #{description}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        UPDATE t_invoice_type SET
            type_name = #{typeName},
            tax_rate = #{taxRate},
            enabled = #{enabled},
            description = #{description},
            updated_at = #{updatedAt}
        WHERE type_id = #{typeId}
    </update>

    <delete id="deleteById">
        DELETE FROM t_invoice_type WHERE type_id = #{typeId}
    </delete>

    <select id="findById" resultMap="InvoiceTypeResultMap">
        SELECT * FROM t_invoice_type WHERE type_id = #{typeId}
    </select>

    <select id="findByCode" resultMap="InvoiceTypeResultMap">
        SELECT * FROM t_invoice_type WHERE type_code = #{typeCode}
    </select>

    <select id="findAll" resultMap="InvoiceTypeResultMap">
        SELECT * FROM t_invoice_type ORDER BY type_code
    </select>

    <select id="findByEnabled" resultMap="InvoiceTypeResultMap">
        SELECT * FROM t_invoice_type WHERE enabled = #{enabled} ORDER BY type_code
    </select>
</mapper>
