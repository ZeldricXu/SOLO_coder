<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <suppress checks="MagicNumber" files=".*Test\.java"/>
    <suppress checks="MethodLength" files=".*Test\.java"/>
    <suppress checks="MissingJavadocMethod" files=".*Test\.java"/>
    <suppress checks="MagicNumber" files=".*Config\.java"/>
    <suppress checks="MagicNumber" files=".*Application\.java"/>
    <suppress checks="LineLength" files=".*Application\.java"/>
    <suppress checks="CyclomaticComplexity" files=".*Service\.java"/>
    <suppress checks="JavaNCSS" files=".*Service\.java"/>
    <suppress checks="NPathComplexity" files=".*Service\.java"/>
    <suppress checks="ParameterNumber" files=".*Service\.java"/>
</suppressions>
