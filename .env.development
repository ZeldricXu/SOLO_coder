APP_ENV=development

SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_JWT_SECRET=dev-jwt-secret-change-me

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inference_platform
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

TRITON_GRPC_HOST=localhost
TRITON_GRPC_PORT=8001
TRITON_HTTP_PORT=8000
TRITON_MODEL_REPOSITORY_PATH=./model-store

ORCHESTRATOR_RUNTIME_MODE=docker
ORCHESTRATOR_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.01-py3
ORCHESTRATOR_MODEL_REPOSITORY_HOST_PATH=./model-store
ORCHESTRATOR_HEALTH_CHECK_INTERVAL=3s
ORCHESTRATOR_HEALTH_CHECK_INFERENCE=true

MONITORING_PROMETHEUS_PORT=9090
MONITORING_LOG_LEVEL=debug

WEBHOOK_ENABLED=true
WEBHOOK_AUTH_TOKEN=dev-webhook-token
