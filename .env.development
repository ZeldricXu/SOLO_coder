# ========================================
# 开发环境配置
# ========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_WORKERS=1
APP_NAME=ticket-routing-system-dev

# ========================================
# 安全配置（开发环境使用弱密钥）
# ========================================
SECRET_KEY=dev-secret-key-for-local-development-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ========================================
# API 配置
# ========================================
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ========================================
# 数据库配置（开发环境使用 SQLite）
# ========================================
DATABASE_URL=sqlite+aiosqlite:///./dev_app.db
SYNC_DATABASE_URL=sqlite:///./dev_app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=true

# ========================================
# Redis 配置
# ========================================
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=5
REDIS_MAX_CONNECTIONS=10

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========================================
# 限流配置（开发环境放宽限制）
# ========================================
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_BURST=2000

# ========================================
# 监控配置（开发环境禁用 Sentry）
# ========================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
METRICS_ENABLED=true
METRICS_PORT=9090

# ========================================
# 功能开关（全开）
# ========================================
FEATURE_FLAG_SKILL_MATCHING=true
FEATURE_FLAG_LOAD_BALANCING=true
FEATURE_FLAG_AUTO_ASSIGNMENT=true
