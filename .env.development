APP_NAME=DocIntel-Dev
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-me
WORKERS=2
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/doc_understanding_dev
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@db:5432/doc_understanding_dev

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_MAX_RETRIES=3
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=500

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-documents-dev
MINIO_PROCESSED_BUCKET=processed-documents-dev
MINIO_MODEL_BUCKET=model-artifacts-dev
MINIO_BUCKET_BATCHES=batches-dev

OCR_LANGS=ch,en
OCR_USE_GPU=false
OCR_DET_MODEL_DIR=
OCR_REC_MODEL_DIR=
OCR_CLS_MODEL_DIR=

ML_MODEL_CACHE_DIR=/app/.model_cache
ML_DEVICE=cpu
ML_BATCH_SIZE=4
ML_MAX_SEQ_LENGTH=512
GPU_MEMORY_FRACTION=0.7
GPU_MEMORY_LIMIT_MB=

EXTRACTION_MODEL_NAME=qwen-vl-chat
EXTRACTION_MODEL_VERSION=1.0.0
EXTRACTION_MODEL_PATH=
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

LAYOUT_MODEL_NAME=layoutlmv3-base
LAYOUT_MODEL_VERSION=1.0.0
LAYOUT_MODEL_PATH=

TABLE_MODEL_NAME=table-transformer-detection
TABLE_MODEL_VERSION=1.0.0
TABLE_MODEL_PATH=

API_KEYS=
REQUIRE_API_KEY=false

RATE_LIMIT_PER_MINUTE=1000
MAX_CONCURRENT_TASKS=8
TASK_TIMEOUT=3600
TASK_PRIORITY_HIGH=0
TASK_PRIORITY_MEDIUM=5
TASK_PRIORITY_LOW=10

LOG_LEVEL=DEBUG
LOG_DIR=/app/logs

AB_TEST_ENABLED=true
AB_TEST_TRAFFIC_SPLIT='{"model_v1": 0.5, "model_v2": 0.5}'
AB_TEST_METRICS=extraction_accuracy,review_rate,processing_time

ICD10_CODES_FILE=/app/data/icd10_codes.json
