# ============================================
# 开发环境配置
# ============================================

# 服务配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL="postgresql://chaoslab:chaoslab_dev@localhost:5432/chaoslab_dev?schema=public"
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Redis 配置
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=redis_dev
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# 安全配置
JWT_SECRET="dev-jwt-secret-key-change-me-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# 日志配置
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_FILE_PATH="./logs/app.log"

# 限流配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS 配置
CORS_ORIGIN="*"
CORS_CREDENTIALS=true

# 监控配置
METRICS_ENABLED=true
METRICS_PATH="/metrics"
HEALTH_CHECK_PATH="/health"

# 功能开关
FEATURE_CHAOS_INJECTION=true
FEATURE_AUDIT_LOG=true
FEATURE_TRAFFIC_CONTROL=true
FEATURE_DNS_PROXY=true
FEATURE_MTLS_CERT=true
FEATURE_EVENT_STORE=true
FEATURE_IMAGE_DISTRIBUTION=true
FEATURE_SIDECAR=true
