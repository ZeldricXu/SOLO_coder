# 开发环境配置

# 服务配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# 日志配置
LOG_LEVEL=debug
LOG_JSON=false
LOG_DIR=./logs

# JWT 配置
JWT_SECRET=dev-jwt-secret-key-2024-please-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 速率限制
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000
TENANT_RATE_LIMIT_MAX=10000
TENANT_RATE_LIMIT_WINDOW=60000
USER_RATE_LIMIT_MAX=1000
USER_RATE_LIMIT_WINDOW=60000

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false

# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_platform_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000

# 并发配置
MAX_CONCURRENT=200
SCHEDULER_MAX_CONCURRENT=20
SCHEDULER_RETRY=3

# 计费配置
PRICE_API_CALL=0.001
PRICE_STORAGE=0.05
PRICE_COMPUTE=0.01
PRICE_BANDWIDTH=0.02
BILLING_CURRENCY=CNY
BILLING_CYCLE_DAYS=30

# 存储配置
BACKUP_DIR=./backups
BACKUP_COMPRESSION=6
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# 监控配置
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=10000

# 跨域配置
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# 调试配置
DEBUG=true
TRACE_ENABLED=true
SLOW_REQUEST_THRESHOLD=1000
