APP_NAME=enterprise_platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_LOG_LEVEL=debug

RUST_LOG=enterprise_platform=debug,tower_http=debug,axum=debug,sqlx=debug

DATABASE_URL=postgres://user:password@localhost:5432/enterprise_dev
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=10

REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=5

MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=http://localhost:9000/alerts

TEE_ENABLED=false
TEE_SIMULATION=true

SHAMIR_THRESHOLD=2
SHAMIR_TOTAL_SHARES=3
SHAMIR_KEYSTORE_PATH=./data/shares

AUDIT_LOG_PATH=./data/audit.log
AUDIT_LOG_MAX_SIZE=10485760
AUDIT_LOG_MAX_FILES=3

MASKING_ENABLED=true
MASKING_DEFAULT_PATTERN=****

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRE_HOURS=72

API_GATEWAY_TIMEOUT=60
API_GATEWAY_MAX_BODY_SIZE=52428800

TRACE_ID_HEADER=x-trace-id
SIGNATURE_HEADER=x-signature
TIMESTAMP_HEADER=x-timestamp
TIMESTAMP_MAX_AGE=600
