<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.orchestration</groupId>
        <artifactId>task-orchestration-platform</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>web</artifactId>
    <name>Web Application</name>
    <description>主应用模块</description>

    <dependencies>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>sla</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>skillgraph</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>monitoring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>approval</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>flowdesigner</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.orchestration</groupId>
            <artifactId>billing</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
